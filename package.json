{
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/ tests/",
    "format": "biome format --write src/ tests/",
    "check": "biome check --write src/ tests/",
    "test:pipeline": "bun test tests/pipeline",
    "test:pipeline:update": "ZOO_SNAPSHOT_UPDATE=1 bun test tests/pipeline",
    "test:host:pi": "bun test tests/host/pi/harness && bun tests/host/pi/run.ts",
    "test:host:pi:harness": "bun test tests/host/pi/harness"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@opencode-ai/plugin": "^1.4.3",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "@types/node": "^25.9.2",
    "solid-js": "^1.9.12",
    "typescript": "^6.0.3"
  }
}
