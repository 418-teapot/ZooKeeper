def cmd_stats(args: argparse.Namespace) -> None:
    """Show statistics for one or more sessions.

    Args:
        args: Parsed command-line arguments.
    """
    console = _make_console(args)
    json_output = getattr(args, "json", False)

    if getattr(args, "sessions", None) is not None:
        _cmd_stats_multi(args, console)
        return

    # Single-session mode
    path = _resolve_session(args.session_id)
    events = parse_zoo_log(path)
    exact_sid = _session_id_from_path(path)
    steps = query_step_data(exact_sid, args.db_path)

    show_tokens = getattr(args, "tokens", False)
    show_hooks = getattr(args, "hooks", False)

    # 如果数据库中没有该 session 的 step 记录，给出警告
    # （仅在需要展示 token 信息的模式下提醒）
    if not steps and not show_hooks:
        console.print(
            "[yellow]No step-finish records found in database "
            "for this session. Token summary will be empty.[/yellow]"
        )

    if show_tokens and not show_hooks:
        _print_token_summary(console, steps, json_output=json_output)
        return
    if show_hooks and not show_tokens:
        _print_hook_section(
            console, events, exact_sid, json_output=json_output
        )
        return

    _print_full_stats(
        console, events, steps, path, exact_sid, json_output=json_output
    )


def _print_token_summary(
    console: Console,
    steps: list[dict],
    json_output: bool = False,
) -> None:
    """Render only the token-summary section.

    Args:
        console: Rich Console instance.
        steps: List of step dicts from ``query_step_data``.
        json_output: If True, print JSON instead of rich table.
    """
    if not steps:
        if json_output:
            json.dump({"error": "No step data found"}, sys.stdout, indent=2)
            print()
        else:
            console.print(
                "[yellow]No step data found for this session.[/yellow]"
            )
        return

    total_input = sum(s["input_tokens"] for s in steps)
    total_output = sum(s["output_tokens"] for s in steps)
    total_cache_read = sum(s["cache_read"] for s in steps)
    total_cache_write = sum(s["cache_write"] for s in steps)
    total_cost = sum(s["cost"] for s in steps)
    n = len(steps)
    avg_input = total_input / n if n else 0
    avg_output = total_output / n if n else 0
    hit_rate = _cache_hit_rate(total_cache_read, total_input)

    if json_output:
        json.dump(
            {
                "total_input": total_input,
                "total_output": total_output,
                "total_cache_read": total_cache_read,
                "total_cache_write": total_cache_write,
                "avg_input_per_turn": round(avg_input, 1),
                "avg_output_per_turn": round(avg_output, 1),
                "cache_hit_rate": round(hit_rate, 2),
                "est_cost": round(total_cost, 4),
                "num_steps": n,
            },
            sys.stdout,
            indent=2,
        )
        print()
        return

    table = Table(title="Token Summary", title_justify="left")
    table.add_column("Metric", style="bold")
    table.add_column("Value", justify="right")
    table.add_row("Total input tokens", str(total_input))
    table.add_row("Total output tokens", str(total_output))
    table.add_row("Total cache read", str(total_cache_read))
    table.add_row("Total cache write", str(total_cache_write))
    table.add_row("Avg input / turn", f"{avg_input:.1f}")
    table.add_row("Avg output / turn", f"{avg_output:.1f}")
    table.add_row(
        "Cache hit rate",
        f"{hit_rate:.2f}% ({total_cache_read:,} / {total_input + total_cache_read:,})",
    )
    table.add_row("Est. cost", f"${total_cost:.4f}")
    console.print(table)


def _print_hook_section(
    console: Console,
    events: list[dict],
    session_id: str,
    json_output: bool = False,
) -> None:
    """Render only the hook-breakdown section.

    Args:
        console: Rich Console instance.
        events: Parsed zoo JSONL events.
        session_id: The session ID to display in the title.
        json_output: If True, print JSON instead of rich table.
    """
    hook_counts: Counter[str] = Counter(
        e.get("hook", "unknown") for e in events
    )
    hook_events: dict[str, Counter[str]] = defaultdict(Counter)
    for e in events:
        hook = e.get("hook", "unknown")
        evt = e.get("event", "unknown")
        hook_events[hook][evt] += 1

    if json_output:
        breakdown = {}
        for hook, count in hook_counts.most_common():
            sub = hook_events[hook]
            breakdown[hook] = {
                "count": count,
                "events": dict(sub),
            }
        json.dump(
            {"session_id": session_id, "hook_breakdown": breakdown},
            sys.stdout,
            indent=2,
        )
        print()
        return

    table = Table(
        title=f"Hook Breakdown \u2014 {session_id}",
        title_justify="left",
    )
    table.add_column("Hook", style="bold")
    table.add_column("Count", justify="right")
    table.add_column("Events")
    for hook, count in hook_counts.most_common():
        sub = hook_events[hook]
        detail = ", ".join(f"{evt}:{cnt}" for evt, cnt in sub.most_common())
        table.add_row(hook, str(count), detail)
    console.print(table)


def _print_full_stats(
    console: Console,
    events: list[dict],
    steps: list[dict],
    path: str,
    session_id: str,
    json_output: bool = False,
) -> None:
    """Render full statistics: header, token summary, levels, and hooks.

    Args:
        console: Rich Console instance.
        events: Parsed zoo JSONL events.
        steps: List of step dicts from ``query_step_data``.
        path: Absolute path to the log file.
        session_id: The exact session ID.
        json_output: If True, print JSON instead of rich tables.
    """
    total = len(events)

    # --- Time span ---
    timestamps = [e.get("timestamp", "") for e in events if e.get("timestamp")]
    time_span = ""
    if timestamps:
        try:
            first = datetime.fromisoformat(
                timestamps[0].replace("Z", "+00:00")
            )
            last = datetime.fromisoformat(
                timestamps[-1].replace("Z", "+00:00")
            )
            delta = last - first
            time_span = (
                f"{first.strftime('%Y-%m-%d %H:%M:%S')} \u2192 "
                f"{last.strftime('%Y-%m-%d %H:%M:%S')} "
                f"({_format_duration(delta)})"
            )
        except (ValueError, IndexError):
            time_span = "N/A"

    # --- Active session IDs ---
    session_ids: set[str] = set()
    for e in events:
        sid = e.get("sessionId", "")
        if sid:
            session_ids.add(sid)

    # --- Level counts ---
    level_counts: Counter[str] = Counter(
        e.get("level", "unknown") for e in events
    )

    # --- Hook breakdown ---
    hook_counts: Counter[str] = Counter(
        e.get("hook", "unknown") for e in events
    )
    hook_events: dict[str, Counter[str]] = defaultdict(Counter)
    for e in events:
        hook = e.get("hook", "unknown")
        evt = e.get("event", "unknown")
        hook_events[hook][evt] += 1

    # --- Token summary ---
    token_summary = None
    if steps:
        total_input = sum(s["input_tokens"] for s in steps)
        total_output = sum(s["output_tokens"] for s in steps)
        total_cache_read = sum(s["cache_read"] for s in steps)
        total_cache_write = sum(s["cache_write"] for s in steps)
        total_cost = sum(s["cost"] for s in steps)
        n = len(steps)
        avg_input = total_input / n if n else 0
        avg_output = total_output / n if n else 0
        hit_rate = _cache_hit_rate(total_cache_read, total_input)
        token_summary = {
            "total_input": total_input,
            "total_output": total_output,
            "total_cache_read": total_cache_read,
            "total_cache_write": total_cache_write,
            "avg_input_per_turn": round(avg_input, 1),
            "avg_output_per_turn": round(avg_output, 1),
            "cache_hit_rate": round(hit_rate, 2),
            "est_cost": round(total_cost, 4),
            "num_steps": n,
        }

    if json_output:
        breakdown = {}
        for hook, count in hook_counts.most_common():
            sub = hook_events[hook]
            breakdown[hook] = {
                "count": count,
                "events": dict(sub),
            }
        result = {
            "session_id": session_id,
            "file": path,
            "total_events": total,
            "time_span": time_span if time_span else None,
            "active_session_ids": sorted(session_ids) if session_ids else None,
            "level_distribution": {
                level: level_counts.get(level, 0)
                for level in ("info", "debug", "warn", "error")
            },
            "hook_breakdown": breakdown,
            "token_summary": token_summary,
        }
        json.dump(result, sys.stdout, indent=2)
        print()
        return

    console.print(
        f"\n[bold]Stats for session:[/bold] [cyan]{session_id}[/cyan]"
    )
    console.print(f"File: [dim]{path}[/dim]")
    console.print(f"Total events: [bold]{total}[/bold]")
    console.print(f"Time span: {time_span}")
    if session_ids:
        console.print(
            "Active session IDs: "
            f"[green]{', '.join(sorted(session_ids))}[/green]"
        )

    # --- Token summary ---
    if steps:
        total_input = sum(s["input_tokens"] for s in steps)
        total_output = sum(s["output_tokens"] for s in steps)
        total_cache_read = sum(s["cache_read"] for s in steps)
        total_cost = sum(s["cost"] for s in steps)
        n = len(steps)
        avg_input = total_input / n if n else 0
        avg_output = total_output / n if n else 0
        hit_rate = _cache_hit_rate(total_cache_read, total_input)

        tok_table = Table(title="Token Summary", title_justify="left")
        tok_table.add_column("Metric", style="bold")
        tok_table.add_column("Value", justify="right")
        tok_table.add_row("Total input tokens", str(total_input))
        tok_table.add_row("Total output tokens", str(total_output))
        tok_table.add_row("Total cache read", str(total_cache_read))
        tok_table.add_row("Total cache write", str(total_cache_write))
        tok_table.add_row("Avg input / turn", f"{avg_input:.1f}")
        tok_table.add_row("Avg output / turn", f"{avg_output:.1f}")
        denom = total_input + total_cache_read
        tok_table.add_row(
            "Cache hit rate",
            f"{hit_rate:.2f}% ({total_cache_read:,} / {denom:,})",
        )
        tok_table.add_row("Est. cost", f"${total_cost:.4f}")
        console.print(tok_table)

    # --- Level distribution ---
    level_counts: Counter[str] = Counter(
        e.get("level", "unknown") for e in events
    )
    level_table = Table(title="Level Distribution", title_justify="left")
    level_table.add_column("Level", style="bold")
    level_table.add_column("Count", justify="right")
    for level in ("info", "debug", "warn", "error"):
        count = level_counts.get(level, 0)
        style = _LEVEL_STYLES.get(level, "")
        level_table.add_row(f"[{style}]{level}[/{style}]", str(count))
    console.print(level_table)

    # --- Hook breakdown ---
    hook_counts: Counter[str] = Counter(
        e.get("hook", "unknown") for e in events
    )
    hook_events: dict[str, Counter[str]] = defaultdict(Counter)
    for e in events:
        hook = e.get("hook", "unknown")
        evt = e.get("event", "unknown")
        hook_events[hook][evt] += 1

    hook_table = Table(title="Hook Breakdown", title_justify="left")
    hook_table.add_column("Hook", style="bold")
    hook_table.add_column("Count", justify="right")
    hook_table.add_column("Events")
    for hook, count in hook_counts.most_common():
        sub = hook_events[hook]
        detail = ", ".join(f"{evt}:{cnt}" for evt, cnt in sub.most_common())
        hook_table.add_row(hook, str(count), detail)
    console.print(hook_table)


