def cmd_impact(args: argparse.Namespace) -> None:
    """Analyze how zoo hook triggers affect cache hit rates.

    Args:
        args: Parsed command-line arguments.
    """
    console = _make_console(args)
    window = args.window
    db_path = args.db_path

    # Resolve session(s)
    session_ids: list[str] = []
    if getattr(args, "session", None):
        path = _resolve_session(args.session)
        session_ids.append(_session_id_from_path(path))
    else:
        sessions = query_recent_sessions(
            n=args.sessions,
            db_path=db_path,
            include_children=getattr(args, "all", False),
        )
        if not sessions:
            console.print("[yellow]No sessions found in database.[/yellow]")
            return
        session_ids = [s["id"] for s in sessions]

    # Analyze each session independently to avoid cross-session mixing
    hook_analysis: dict[str, list[dict]] = defaultdict(list)
    recovery_data: dict[int, list[float]] = defaultdict(list)
    cost_data: dict[str, dict[str, float]] = defaultdict(
        lambda: {"before": 0.0, "after": 0.0}
    )
    verbose_rows: list[dict] = []
    found_steps = False

    for sid in session_ids:
        # --- Get hooks for this session from JSONL ---
        hooks: list[dict] = []
        log_path = resolve_session_path(sid)
        if log_path:
            try:
                events = parse_zoo_log(log_path)
                for e in events:
                    if e.get("hook") and e.get("timestamp"):
                        if args.hook and e.get("hook") != args.hook:
                            continue
                        hooks.append(e)
            except Exception:  # noqa: BLE001
                pass

        # --- Get steps for this session from DB ---
        db_steps = query_step_data(sid, db_path)
        steps = sorted(
            [s for s in db_steps if s.get("time_created")],
            key=lambda s: s["time_created"],
        )

        if not hooks:
            continue

        # Sort hooks by timestamp for deterministic processing
        hooks.sort(key=lambda e: e.get("timestamp", ""))

        if steps:
            found_steps = True

        for hook in hooks:
            hook_ts = hook.get("timestamp", "")
            hook_name = hook.get("hook", "unknown")

            if not hook_ts:
                continue

            # Binary search to find where this hook falls among steps
            step_times = [s["time_created"] for s in steps]
            pos = bisect.bisect_left(step_times, hook_ts)

            # Steps before (same session only, using step index distance)
            before_steps: list[tuple[int, dict]] = []
            for k in range(pos - 1, max(-1, pos - 1 - window), -1):
                if k < 0:
                    break
                s = steps[k]
                dist = pos - k  # steps before: 1, 2, 3, ...
                before_steps.append((dist, s))

            # Steps after (same session only, using step index distance)
            after_steps: list[tuple[int, dict]] = []
            for k in range(pos, min(len(steps), pos + window)):
                s = steps[k]
                dist = k - pos + 1  # steps after: 1, 2, 3, ...
                after_steps.append((dist, s))

            before_rates = [
                _cache_hit_rate(s["cache_read"], s["input_tokens"])
                for _, s in before_steps
            ]
            after_rates = [
                _cache_hit_rate(s["cache_read"], s["input_tokens"])
                for _, s in after_steps
            ]

            avg_before = (
                sum(before_rates) / len(before_rates) if before_rates else 0.0
            )
            avg_after = (
                sum(after_rates) / len(after_rates) if after_rates else 0.0
            )

            hook_analysis[hook_name].append(
                {
                    "session_id": sid,
                    "timestamp": hook_ts,
                    "before": avg_before,
                    "after": avg_after,
                    "n_before": len(before_steps),
                    "n_after": len(after_steps),
                }
            )

            # Recovery curve (distance = step index difference within session)
            for dist, s in before_steps:
                hr = _cache_hit_rate(s["cache_read"], s["input_tokens"])
                recovery_data[-dist].append(hr)
            for dist, s in after_steps:
                hr = _cache_hit_rate(s["cache_read"], s["input_tokens"])
                recovery_data[dist].append(hr)

            # Cost data
            for _, s in before_steps:
                cost_data[hook_name]["before"] += s.get("cost", 0) or 0
            for _, s in after_steps:
                cost_data[hook_name]["after"] += s.get("cost", 0) or 0

            # Verbose detail
            if args.verbose:
                verbose_rows.append(
                    {
                        "session_id": sid,
                        "hook": hook_name,
                        "timestamp": hook_ts,
                        "avg_before": avg_before,
                        "avg_after": avg_after,
                        "delta": avg_after - avg_before,
                        "before_steps": [
                            {
                                "cache_read": s["cache_read"],
                                "input_tokens": s["input_tokens"],
                                "hit_rate": _cache_hit_rate(
                                    s["cache_read"], s["input_tokens"]
                                ),
                                "cost": s.get("cost", 0),
                            }
                            for _, s in before_steps
                        ],
                        "after_steps": [
                            {
                                "cache_read": s["cache_read"],
                                "input_tokens": s["input_tokens"],
                                "hit_rate": _cache_hit_rate(
                                    s["cache_read"], s["input_tokens"]
                                ),
                                "cost": s.get("cost", 0),
                            }
                            for _, s in after_steps
                        ],
                    }
                )

    if not hook_analysis:
        console.print(
            "[yellow]No hook events found in session logs "
            "matching the filter.[/yellow]"
        )
        return

    if not found_steps:
        console.print(
            "[yellow]No step-finish records found in database "
            "for any session. Impact analysis will be incomplete.[/yellow]"
        )

    # --- JSON output ---
    if getattr(args, "json", False):
        hook_agg = {}
        for hook_name, triggers in sorted(hook_analysis.items()):
            n = len(triggers)
            all_before = [t["before"] for t in triggers]
            all_after = [t["after"] for t in triggers]
            avg_b = sum(all_before) / n if n else 0.0
            avg_a = sum(all_after) / n if n else 0.0
            delta = avg_a - avg_b
            total_steps = sum(t["n_before"] + t["n_after"] for t in triggers)
            hook_agg[hook_name] = {
                "triggers": n,
                "avg_before": round(avg_b, 1),
                "avg_after": round(avg_a, 1),
                "delta": round(delta, 1),
                "correlated_steps": total_steps,
            }

        recovery_curve = []
        for dist in sorted(recovery_data.keys()):
            rates = recovery_data[dist]
            recovery_curve.append(
                {
                    "distance": dist,
                    "avg_hit_rate": round(sum(rates) / len(rates), 1),
                    "samples": len(rates),
                }
            )

        result = {
            "sessions_analyzed": session_ids,
            "window": window,
            "hook_aggregation": hook_agg,
            "recovery_curve": recovery_curve,
        }

        if args.cost:
            cost_impact = {}
            for hook_name in sorted(cost_data):
                before = cost_data[hook_name]["before"]
                after = cost_data[hook_name]["after"]
                cost_impact[hook_name] = {
                    "before_cost": round(before, 4),
                    "after_cost": round(after, 4),
                    "ratio": round(after / before, 2) if before > 0 else None,
                }
            result["cost_impact"] = cost_impact

        if args.verbose:
            result["verbose"] = verbose_rows

        json.dump(result, sys.stdout, indent=2, default=str)
        print()
        return

    # ------------------------------------------------------------------
    # Section 1: Hook-by-Hook Aggregation
    # ------------------------------------------------------------------
    agg_table = Table(
        title="Hook-by-Hook Aggregation",
        title_justify="left",
    )
    agg_table.add_column("Hook", style="bold")
    agg_table.add_column("Triggers", justify="right")
    agg_table.add_column("Avg Before", justify="right")
    agg_table.add_column("Avg After", justify="right")
    agg_table.add_column("\u0394", justify="right")
    agg_table.add_column("Correlated Steps", justify="right")

    for hook_name, triggers in sorted(hook_analysis.items()):
        n = len(triggers)
        all_before = [t["before"] for t in triggers]
        all_after = [t["after"] for t in triggers]
        avg_b = sum(all_before) / n if n else 0.0
        avg_a = sum(all_after) / n if n else 0.0
        delta = avg_a - avg_b
        total_steps = sum(t["n_before"] + t["n_after"] for t in triggers)

        delta_str = f"{delta:+.1f}pp"
        if delta > 0:
            delta_str = f"[green]{delta_str}[/green]"
        elif delta < 0:
            delta_str = f"[red]{delta_str}[/red]"

        agg_table.add_row(
            hook_name,
            str(n),
            f"{avg_b:.1f}%",
            f"{avg_a:.1f}%",
            delta_str,
            str(total_steps),
        )

    console.print(agg_table)

    # ------------------------------------------------------------------
    # Section 2: Cache Recovery Curve
    # ------------------------------------------------------------------
    curve_table = Table(
        title="Cache Recovery Curve",
        title_justify="left",
    )
    curve_table.add_column("Distance", justify="right", style="bold")
    curve_table.add_column("Avg Hit Rate", justify="right")
    curve_table.add_column("Histogram")
    curve_table.add_column("Samples", justify="right")

    for dist in sorted(recovery_data.keys()):
        rates = recovery_data[dist]
        avg_rate = sum(rates) / len(rates)
        bar = _hit_rate_bar(avg_rate)
        curve_table.add_row(
            str(dist),
            f"{avg_rate:.1f}%",
            bar,
            str(len(rates)),
        )

    console.print(curve_table)

    # ------------------------------------------------------------------
    # Section 3: Cost Impact (optional)
    # ------------------------------------------------------------------
    if args.cost:
        cost_table = Table(
            title="Cost Impact (before vs after hook trigger)",
            title_justify="left",
        )
        cost_table.add_column("Hook", style="bold")
        cost_table.add_column("Before Cost", justify="right")
        cost_table.add_column("After Cost", justify="right")
        cost_table.add_column("Ratio", justify="right")

        for hook_name in sorted(cost_data):
            before = cost_data[hook_name]["before"]
            after = cost_data[hook_name]["after"]
            ratio = f"{(after / before):.2f}x" if before > 0 else "N/A"
            cost_table.add_row(
                hook_name,
                f"${before:.4f}",
                f"${after:.4f}",
                ratio,
            )

        console.print(cost_table)

    # ------------------------------------------------------------------
    # Section 4: Verbose per-trigger detail (optional)
    # ------------------------------------------------------------------
    if args.verbose:
        for row in verbose_rows:
            ts = row.get("timestamp", "")
            ts_short = _shorten_timestamp(ts) if ts else ""
            console.print(
                f"\n[bold]Session {row['session_id'][:8]}..[/bold]"
                f" | [cyan]{row['hook']}[/cyan]"
                f" | {ts_short}"
            )
            console.print(
                f"  Before ({len(row['before_steps'])} steps): "
                f"avg hit rate [yellow]{row['avg_before']:.1f}%[/yellow]"
            )
            for b in row["before_steps"]:
                console.print(
                    "    cache_read="
                    f"{b['cache_read']}, "
                    f"input={b['input_tokens']}, "
                    f"hit_rate={b['hit_rate']:.1f}%, "
                    f"cost=${b['cost']:.4f}"
                )
            console.print(
                f"  After ({len(row['after_steps'])} steps): "
                f"avg hit rate [yellow]{row['avg_after']:.1f}%[/yellow]"
            )
            for a in row["after_steps"]:
                console.print(
                    "    cache_read="
                    f"{a['cache_read']}, "
                    f"input={a['input_tokens']}, "
                    f"hit_rate={a['hit_rate']:.1f}%, "
                    f"cost=${a['cost']:.4f}"
                )
            delta = row.get("delta", 0)
            delta_color = "green" if delta > 0 else "red"
            console.print(
                f"  Delta: [{delta_color}]{delta:+.1f}pp[/{delta_color}]"
            )


