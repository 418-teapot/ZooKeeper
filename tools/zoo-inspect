def build_parser() -> argparse.ArgumentParser:
    """Build the argument parser for zoo-inspect.

    Returns:
        Configured ArgumentParser instance.
    """
    parser = argparse.ArgumentParser(
        description=(
            "ZooKeeper session inspector \u2014 stats, timeline, "
            "and impact analysis for "
            f"{_get_zoo_log_dir()}/ sessions."
        ),
    )

    # Global flags (available to all subcommands)
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output results in JSON format",
    )
    parser.add_argument(
        "--db",
        dest="db_path",
        default="~/.local/share/opencode/opencode.db",
        help="Path to the OpenCode SQLite database"
        " (default: ~/.local/share/opencode/opencode.db)",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable colored output",
    )

    subparsers = parser.add_subparsers(dest="command", title="Commands")

    # --- stats ---
    p_stats = subparsers.add_parser(
        "stats", help="Show statistics for a session or multiple sessions"
    )
    p_stats.add_argument(
        "session_id",
        nargs="?",
        default=None,
        help="Session ID (full or prefix)",
    )
    p_stats.add_argument(
        "--sessions",
        type=int,
        default=None,
        metavar="N",
        help="Show cross-session token summary for last N sessions",
    )
    p_stats.add_argument(
        "--all",
        action="store_true",
        help="Include child sessions in multi-session mode",
    )
    p_stats.add_argument(
        "--tokens",
        action="store_true",
        help="Show only the token summary section",
    )
    p_stats.add_argument(
        "--hooks",
        action="store_true",
        help="Show only the hook breakdown section",
    )

    # --- timeline ---
    p_timeline = subparsers.add_parser(
        "timeline", help="Show event timeline for a session"
    )
    p_timeline.add_argument("session_id", help="Session ID (full or prefix)")
    p_timeline.add_argument(
        "--all",
        action="store_true",
        dest="all_events",
        help="Show all events (no row limit)",
    )

    # --- impact ---
    p_impact = subparsers.add_parser(
        "impact",
        help="Analyze how zoo hook triggers affect cache hit rates",
    )
    p_impact.add_argument(
        "--sessions",
        type=int,
        default=5,
        metavar="N",
        help="Number of recent sessions to analyze (default: 5)",
    )
    p_impact.add_argument(
        "--session",
        metavar="ID",
        default=None,
        help="Analyze a single session by ID",
    )
    p_impact.add_argument(
        "--all",
        action="store_true",
        help="Include child sessions",
    )
    p_impact.add_argument(
        "--hook",
        metavar="NAME",
        default=None,
        help="Filter to a specific hook type",
    )
    p_impact.add_argument(
        "--window",
        type=int,
        default=6,
        metavar="N",
        help="Observation window steps before/after hook (default: 6)",
    )
    p_impact.add_argument(
        "--cost",
        action="store_true",
        help="Show cost estimation table",
    )
    p_impact.add_argument(
        "--verbose",
        action="store_true",
        help="Show per-event detail",
    )

    return parser


def main() -> None:
    """Entry point for zoo-inspect."""
    _setup_logging()
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "stats":
        if args.session_id is None and args.sessions is None:
            print(
                "Error: provide a session_id or use --sessions <N>",
                file=sys.stderr,
            )
            sys.exit(1)
        cmd_stats(args)
    elif args.command == "timeline":
        cmd_timeline(args)
    elif args.command == "impact":
        cmd_impact(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
