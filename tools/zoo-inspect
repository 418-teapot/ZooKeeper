def _cmd_stats_multi(args: argparse.Namespace, console: Console) -> None:
    """Render the cross-session token summary table.

    Args:
        args: Parsed command-line arguments.
        console: Rich Console instance.
    """
    sessions = query_recent_sessions(
        n=args.sessions,
        db_path=args.db_path,
        include_children=getattr(args, "all", False),
    )
    if not sessions:
        console.print("[yellow]No sessions found in database.[/yellow]")
        return

    rows: list[dict] = []
    totals: dict[str, float] = {
        "input": 0,
        "output": 0,
        "cache_read": 0,
        "cost": 0.0,
        "hook_events": 0,
    }

    for s in sessions:
        sid = s["id"]
        inp = s.get("tokens_input", 0) or 0
        out = s.get("tokens_output", 0) or 0
        cache_read = s.get("tokens_cache_read", 0) or 0
        cost = s.get("cost", 0) or 0

        # Count hook events from zoo JSONL
        hook_count = 0
        log_path = resolve_session_path(sid)
        if log_path:
            try:
                log_events = parse_zoo_log(log_path)
                hook_count = sum(1 for e in log_events if e.get("hook"))
            except Exception:  # noqa: BLE001
                pass

        hit_rate = _cache_hit_rate(cache_read, inp)
        rows.append(
            {
                "id": sid,
                "input": inp,
                "output": out,
                "hit_rate": hit_rate,
                "cost": cost,
                "hook_events": hook_count,
            }
        )

        totals["input"] += inp
        totals["output"] += out
        totals["cache_read"] += cache_read
        totals["cost"] += cost
        totals["hook_events"] += hook_count

    total_hit_rate = _cache_hit_rate(totals["cache_read"], totals["input"])

    if getattr(args, "json", False):
        json.dump(
            {
                "sessions": rows,
                "total": {
                    "input": int(totals["input"]),
                    "output": int(totals["output"]),
                    "cache_read": int(totals["cache_read"]),
                    "hit_rate": round(total_hit_rate, 2),
                    "cost": round(totals["cost"], 4),
                    "hook_events": int(totals["hook_events"]),
                },
            },
            sys.stdout,
            indent=2,
        )
        print()
        return

    table = Table(
        title=f"Cross-Session Token Summary (last {args.sessions} sessions)",
        title_justify="left",
    )
    table.add_column("Session ID", style="cyan", no_wrap=True)
    table.add_column("Input", justify="right")
    table.add_column("Output", justify="right")
    table.add_column("Hit Rate", justify="right")
    table.add_column("Cost", justify="right")
    table.add_column("Hook Events", justify="right")

    for r in rows:
        sid_short = r["id"][:8] + ".." if len(r["id"]) > 8 else r["id"]
        table.add_row(
            sid_short,
            str(r["input"]),
            str(r["output"]),
            f"{r['hit_rate']:.2f}%",
            f"${r['cost']:.4f}",
            str(r["hook_events"]),
        )

    table.add_row(
        "[bold]Total[/bold]",
        str(int(totals["input"])),
        str(int(totals["output"])),
        f"[bold]{total_hit_rate:.2f}%[/bold]",
        f"[bold]${totals['cost']:.4f}[/bold]",
        str(int(totals["hook_events"])),
    )

    console.print(table)


# ---------------------------------------------------------------------------
# Timeline subcommand (unchanged logic, global flags respected)
# ---------------------------------------------------------------------------


def cmd_timeline(args: argparse.Namespace) -> None:
    """Show a timeline of events for a session.

    Args:
        args: Parsed command-line arguments.
    """
    console = _make_console(args)

    path = _resolve_session(args.session_id)
    events = parse_zoo_log(path)

    if not events:
        console.print("[yellow]No events found in log file.[/yellow]")
        return

    events_sorted = sorted(events, key=lambda e: e.get("timestamp", ""))

    max_rows = 30
    total = len(events_sorted)
    if total > max_rows and not getattr(args, "all_events", False):
        console.print(
            f"[yellow]Showing first {max_rows} of {total} events "
            f"(use --all to see all)[/yellow]"
        )
        events_sorted = events_sorted[:max_rows]

    table = Table(title=f"Timeline: {args.session_id}")
    table.add_column("Time", style="cyan", no_wrap=True)
    table.add_column("Level", no_wrap=True)
    table.add_column("Hook")
    table.add_column("Event")
    table.add_column("Details")

    for e in events_sorted:
        ts = e.get("timestamp", "")
        time_str = _shorten_timestamp(ts)

        level = e.get("level", "info")
        level_style = _LEVEL_STYLES.get(level, "white")
        level_display = f"[{level_style}]{level}[/{level_style}]"

        hook = e.get("hook", "")
        event = e.get("event", "")
        details = _format_details(e)

        table.add_row(time_str, level_display, hook, event, details)

    console.print(table)


