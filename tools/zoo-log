#!/usr/bin/env python3
"""ZooKeeper log filter — real-time JSON log viewer.

Session ID resolution: Supports prefix matching via
:func:`_parser.resolve_session_path` (globbing ``opencode-<prefix>*.log``).
"""

import argparse
import os
import subprocess
import sys

from _db import _setup_logging
from _parser import _get_zoo_log_dir, resolve_session_path

LOG_DIR = _get_zoo_log_dir()


def build_jq_filter(
    hook: str | None, level: str | None, event: str | None
) -> str | None:
    """Build a jq select filter string. Returns None if no filters given."""
    parts = []
    if hook is not None:
        parts.append(f'.hook == "{hook}"')
    if level is not None:
        parts.append(f'.level == "{level}"')
    if event is not None:
        parts.append(f'.event == "{event}"')
    if parts:
        return " and ".join(parts)
    return None


def run_jq_pipeline(
    filter_str: str | None, unbuffered: bool = True
) -> list[str]:
    """Build jq argument list for the given filter."""
    args = ["/usr/bin/jq", "-c"]
    if unbuffered:
        args.append("--unbuffered")
    if filter_str:
        args.append(f"select({filter_str})")
    else:
        args.append(".")
    return args


def cmd_tail(args: argparse.Namespace) -> None:
    """Tail -f a log file with optional jq filtering."""
    path = resolve_session_path(args.session_id)
    if path is None:
        print(
            f"Error: no unique log file found for session '{args.session_id}'",
            file=sys.stderr,
        )
        sys.exit(2)

    if args.raw:
        # Bypass jq entirely — inherit tail output directly
        try:
            subprocess.run(["tail", "-n", "0", "-f", path], check=False)
        except KeyboardInterrupt:
            pass
        return

    filter_str = build_jq_filter(args.hook, args.level, args.event)
    jq_args = run_jq_pipeline(filter_str)

    procs: list[subprocess.Popen] = []
    try:
        # Build grep pre-filter patterns for cheap substring matching.
        # grep is inserted before jq so jq only parses lines that may match.
        grep_patterns = []
        if args.event is not None:
            grep_patterns.append(f'"event":"{args.event}"')
        if args.hook is not None:
            grep_patterns.append(f'"hook":"{args.hook}"')
        if args.level is not None:
            grep_patterns.append(f'"level":"{args.level}"')

        # Start tail from the end (no history replay)
        tail_proc = subprocess.Popen(
            ["tail", "-n", "0", "-f", path],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        procs.append(tail_proc)
        prev_pipe = tail_proc.stdout

        # Chain grep pre-filters (AND semantics — each pipe narrows further)
        for pattern in grep_patterns:
            grep_proc = subprocess.Popen(
                ["grep", "-F", pattern],
                stdin=prev_pipe,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
            if prev_pipe is not None:
                prev_pipe.close()
            prev_pipe = grep_proc.stdout
            procs.append(grep_proc)

        jq_proc = subprocess.Popen(
            jq_args,
            stdin=prev_pipe,
            stdout=sys.stdout,
            stderr=None,  # inherit parent stderr so jq errors are visible
        )
        if prev_pipe is not None:
            prev_pipe.close()
        procs.append(jq_proc)

        jq_proc.wait()
    except KeyboardInterrupt:
        pass
    finally:
        for proc in procs:
            try:
                proc.terminate()
            except OSError:
                pass


def cmd_show(args: argparse.Namespace) -> None:
    """Read an entire log file with optional jq filtering."""
    path = resolve_session_path(args.session_id)
    if path is None:
        print(
            f"Error: no unique log file found for session '{args.session_id}'",
            file=sys.stderr,
        )
        sys.exit(2)

    if args.raw:
        with open(path, "r", encoding="utf-8") as f:
            sys.stdout.write(f.read())
        return

    filter_str = build_jq_filter(args.hook, args.level, args.event)
    jq_args = run_jq_pipeline(filter_str, unbuffered=False)

    with open(path, "r", encoding="utf-8") as f:
        proc = subprocess.Popen(
            jq_args,
            stdin=f,
            stdout=sys.stdout,
            stderr=None,  # inherit parent stderr so jq errors are visible
        )
        proc.wait()


def main() -> None:
    _setup_logging()
    parser = argparse.ArgumentParser(
        description=(
            "ZooKeeper log filter \u2014 real-time JSON log viewer"
            f" for {LOG_DIR}/opencode-*.log."
        ),
    )
    subparsers = parser.add_subparsers(dest="command", title="Commands")

    # --- tail ---
    p_tail = subparsers.add_parser(
        "tail", help="Tail -f a log file in real-time"
    )
    p_tail.add_argument("session_id", help="Session ID (full or prefix)")
    p_tail.add_argument("--hook", help="Filter by hook name")
    p_tail.add_argument(
        "--level", help="Filter by level (e.g. info, warn, error)"
    )
    p_tail.add_argument("--event", help="Filter by event name")
    p_tail.add_argument(
        "--raw",
        action="store_true",
        help="Skip jq filtering, output raw lines",
    )

    # --- show ---
    p_show = subparsers.add_parser(
        "show", help="Read and filter an entire log file"
    )
    p_show.add_argument("session_id", help="Session ID (full or prefix)")
    p_show.add_argument("--hook", help="Filter by hook name")
    p_show.add_argument(
        "--level", help="Filter by level (e.g. info, warn, error)"
    )
    p_show.add_argument("--event", help="Filter by event name")
    p_show.add_argument(
        "--raw",
        action="store_true",
        help="Skip jq filtering, output raw lines",
    )

    args = parser.parse_args()

    if not os.path.isdir(LOG_DIR):
        print(
            f"Error: log directory {LOG_DIR} does not exist", file=sys.stderr
        )
        sys.exit(2)

    if args.command == "tail":
        cmd_tail(args)
    elif args.command == "show":
        cmd_show(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
