def _render_timeline_rich(timeline: list[dict], console: Console) -> None:
    """Render timeline events using rich Tree/Table.

    Groups ZooKeeper events under their parent LLM or session turn.
    Child session events are indented and prefixed with ``[子: <agent>]``.
    """
    if not timeline:
        console.print("[yellow]No events in timeline.[/yellow]")
        return

    table = Table(
        title=None,
        show_header=False,
        box=None,
        padding=(0, 1),
        collapse_padding=True,
    )
    table.add_column("Time", style="dim", no_wrap=True, width=9)
    table.add_column("Icon", no_wrap=True, width=2)
    table.add_column("Summary", no_wrap=False)

    for e in timeline:
        ts = e.get("timestamp", "")
        time_str = ts[11:19] if len(ts) >= 19 else ts[-8:]

        icon = e.get("icon", "●")
        etype = e.get("type", "hook")
        source = e.get("source", "")
        depth = e.get("depth", 0)

        icon_color = TYPE_STYLES.get(etype, "white")
        icon_str = Text(icon, style=icon_color)

        summary_text = Text(e.get("summary", ""))

        # Duration prefix for LLM/tool events
        dur = e.get("duration_sec")
        if dur is not None:
            summary_text = Text.assemble(
                (f"[{dur:.1f}s] ", "dim"),
                summary_text,
            )

        # Child session prefix + indentation
        if depth > 0:
            agent = e.get("session_agent", "")
            prefix = f"[子:{agent}] " if agent else "[子session] "
            summary_text = Text.assemble(
                ("  " * depth, ""),
                (prefix, "dim"),
                (summary_text.plain, ""),
            )
        elif source == "zoo":
            summary_text = Text.assemble(
                ("[zoo] ", "cyan"),
                (e.get("summary", ""), "dim"),
            )

        table.add_row(time_str, icon_str, summary_text)

    console.print(table)


def _build_model_map(timeline: list[dict]) -> list[str]:
    """Build a parallel list of active model names for each timeline index.

    Walks the timeline and tracks the most recent LLM runtime selected or
    session-created model name.  Events before any LLM event get an empty
    string.
    """
    current = ""
    models: list[str] = []
    for e in timeline:
        if e.get("type") == "llm":
            detail = e.get("detail", {})
            m = detail.get("model", "")
            if m:
                current = m
        elif e.get("type") == "session":
            detail = e.get("detail", {})
            m = detail.get("model_id", detail.get("model", ""))
            if m and not current:
                current = m
        models.append(current)
    return models


def _attach_durations(timeline: list[dict]) -> None:
    """Attach duration_sec (float) to timeline events in-place.

    - For tool_* events from opencode: uses ``detail.duration_sec`` from
      the parsed log entry (``evaluated`` line's ``duration=`` field).
    - For LLM events: matches to the ``assistant_reply`` DB event whose
      ``msg_time_created``/``msg_time_completed`` range contains the LLM
      event timestamp, and uses the reply's duration
    - Zoo and session events are left unchanged (no duration).
    """
    # Phase 2a: forward tool durations from detail
    for e in timeline:
        etype = e.get("type", "")
        if etype.startswith("tool_"):
            dur = e.get("detail", {}).get("duration_sec")
            if dur is not None:
                e["duration_sec"] = dur

    # Phase 2b: match tool events against DB tool durations
    # (for events where the opencode log has no duration field)
    # Collect ALL session IDs in the timeline (root + children)
    all_sids: set[str] = set()
    for e in timeline:
        sid = e.get("session_id", "")
        if sid:
            all_sids.add(sid)

    # Query tool durations for all sessions at once (avoid N+1)
    all_tool_durations: list[dict] = []
    if all_sids:
        all_tool_durations = query_tool_durations_batch(list(all_sids))

    if all_tool_durations:
        for e in timeline:
            etype = e.get("type", "")
            if not etype.startswith("tool_"):
                continue
            if e.get("duration_sec") is not None:
                continue  # already set from Phase 2a

            # Extract tool name from summary (e.g. "read: src/auth/middleware.ts")
            summary = e.get("summary", "")
            if ": " in summary:
                tool_name = summary.split(": ", 1)[0]
            else:
                tool_name = summary

            ts = e.get("timestamp", "")
            if not ts:
                continue
            ts_ms = _iso_to_epoch_ms(ts)
            if ts_ms == 0:
                continue

            # Find best match: same tool name, closest time_start within 30s
            best_match = None
            best_diff = float("inf")
            for td in all_tool_durations:
                if td["tool_name"] != tool_name:
                    continue
                diff = abs(td["time_start"] - ts_ms)
                if diff < best_diff and diff <= 30_000:
                    best_diff = diff
                    best_match = td

            if best_match is not None:
                e["duration_sec"] = best_match["duration_sec"]

    # Phase 3: collect assistant_reply durations keyed by epoch-ms range
    assistant_ranges: list[tuple[int, int, float]] = []
    for e in timeline:
        if e.get("type") == "assistant_reply":
            mc = e.get("msg_time_completed")
            mcr = e.get("msg_time_created")
            if mc is not None and mcr is not None and mc > mcr:
                dur = (mc - mcr) / 1000.0
                assistant_ranges.append((mcr, mc, dur))

    if not assistant_ranges:
        return

    # Phase 3: match LLM events — find the reply whose time range
    # is closest (by midpoint distance) to the LLM event timestamp.
    for e in timeline:
        etype = e.get("type", "")
        if etype not in ("llm", "llm_stream"):
            continue
        ts = e.get("timestamp", "")
        if not ts:
            continue
        ts_ms = _iso_to_epoch_ms(ts)
        if ts_ms == 0:
            continue

        # Step 1: find exact containment matches (ts_ms inside [created, completed])
        exact_matches = [
            (cr, cc, dur)
            for cr, cc, dur in assistant_ranges
            if cr <= ts_ms <= cc
        ]

        if len(exact_matches) == 1:
            # Single exact match — use it
            if exact_matches[0][2] > 0:
                e["duration_sec"] = exact_matches[0][2]
        else:
            # No unique exact match — find the closest by midpoint distance
            # within the 5s grace window
            best_match: float | None = None
            best_dist = float("inf")
            for cr, cc, dur in assistant_ranges:
                if cr <= ts_ms <= cc + 5000:
                    midpoint = (cr + cc) / 2
                    dist = abs(ts_ms - midpoint)
                    if dist < best_dist:
                        best_dist = dist
                        best_match = dur
            if best_match is not None and best_match > 0:
                e["duration_sec"] = best_match


def _truncate_display(text: str, max_cols: int) -> str:
    """Truncate text to fit within *max_cols* display columns (forward scan).

    Handles CJK characters (2 columns each) and emoji using
    ``rich.cells.cell_len`` for correct terminal width measurement.

    Args:
        text: The text to truncate.
        max_cols: Maximum display columns (terminal cell width).

    Returns:
        Truncated text with ``"..."`` suffix if needed, or the original text.
    """
    max_cols = max(max_cols, 4)
    if not text:
        return text
    if cell_len(text) <= max_cols:
        return text
    # Edge case: when the first character is wider than max_cols - 3,
    # we cannot fit first_char + "...". Return "..." as safe fallback.
    if cell_len(text[0]) > max_cols - 3:
        return "..."
    # Walk forward through grapheme boundaries using slicing.
    # Per-char ``cell_len`` misses combining characters and emoji variation
    # selectors (e.g. ⚠️ counts as 1 when iterated char-by-char but 2 as a
    # grapheme), so use ``cell_len(text[:i])`` for accuracy.
    for i in range(1, len(text) + 1):
        w = cell_len(text[:i])
        if w + 3 > max_cols:  # +3 for "..."
            idx = max(i - 1, 1)
            return text[:idx] + "..."
    return text


def _pad(s: str, width: int) -> str:
    """Pad string to exact display width using ``rich.cells.cell_len``.

    Args:
        s: Plain text string (no rich markup).
        width: Target display width in terminal cells.

    Returns:
        Padded string with trailing spaces.
    """
    current = cell_len(s)
    return s + " " * max(0, width - current)


def _render_ops_summary(
    timeline: list[dict],
    stats: dict,
    console: Console,
    verbose: bool = False,
) -> None:
    """Render chronological operations summary with fixed-width columns.

    Each line follows the format::

        HH:MM:SS  model             tag         │ content

    Columns:
        Time    —  8 cells  (``HH:MM:SS``)
        Model   — 18 cells  (right-padded, truncated if > 18)
        Tag     —  dynamic (icon + label, max 14 cells)
        Sep     —  1 cell   (``│``)
        Content — remaining  (sub-agent prefix ``[子:agent] `` when depth > 0)

    Sub-agent depth indents only the time column and the content column
    (after ``│``) by ``depth × 2`` spaces, keeping model and tag columns
    aligned across all depths.
    """
    if not timeline:
        console.print("[yellow]No events in timeline.[/yellow]")
        return

    model_map = _build_model_map(timeline)

    OP_LABELS: dict[str, str] = {
        "tool_read": "读",
        "tool_write": "写",
        "tool_exec": "执行",
        "tool_orch": "编排",
        "tool_other": "其他",
    }

    # Collect tool_* + zoo + llm events in chronological order
    ops: list[dict] = []
    for i, e in enumerate(timeline):
        etype = e.get("type", "")
        source = e.get("source", "")
        if etype.startswith("tool_") or source == "zoo":
            ops.append({"index": i, "event": e})
        elif etype in ("llm", "llm_stream"):
            if verbose:
                ops.append({"index": i, "event": e})
        elif source == "db":
            ops.append({"index": i, "event": e})

    ops = sort_ops_by_session(ops)
    tops, bottoms = mark_block_boundaries(ops)

    # ── Build session_id → session_agent lookup from ops (for tops bsid) ──
    agent_map: dict[str, str] = {}
    for op in ops:
        e = op["event"]
        sid = e.get("session_id", "")
        if sid and sid not in agent_map:
            agent_map[sid] = e.get("session_agent", "")

    # ── Compute dynamic tag column width ──
    tag_labels: list[str] = []
    for op in ops:
        e = op["event"]
        etype = e.get("type", "")
        if etype in ("llm", "llm_stream"):
            tag_labels.append(
                "🤖 LLM stream" if etype == "llm_stream" else "🤖 LLM call"
            )
        elif e.get("source") == "zoo":
            tag_labels.append("zoo")
        elif e.get("source") == "db":
            if etype == "user_msg":
                tag_labels.append("User")
            elif etype == "assistant_reply":
                agent = e.get("agent", "") or "assistant"
                tag_labels.append(f"{agent}:")
            elif etype == "assistant_reasoning" and verbose:
                tag_labels.append("🧠 Reasoning")
        else:
            icon = e.get("icon", "●")
            op_label = OP_LABELS.get(etype, "其他")
            tag_labels.append(f"{icon} {op_label}")

    tag_width = max((cell_len(t) for t in tag_labels), default=8)
    tag_width = min(tag_width, 14)

    # ── Dynamic content width based on terminal size ──
    # Layout: Time(8) + sep(2) + Model(18) + sep(2) + Tag(tag_width)
    #       + sep(1) + │(1) + sep(1) + content
    # = 33 + tag_width + content_width
    term_width = console.width or 120
    content_width = max(20, term_width - 33 - tag_width)

    # ── Agent color map ──
    AGENT_COLORS: dict[str, str] = {
        "explore": "cyan",
        "general": "magenta",
        "build": "blue",
    }
    _DEFAULT_AGENT_COLOR = "green"

    # ── Cache Style objects ──
    S = {
        "dim": Style(dim=True),
        "blue": Style(color="blue"),
        "green": Style(color="green"),
        "cyan": Style(color="cyan"),
        "yellow": Style(color="yellow"),
        "white": Style(color="white"),
        "orange1": Style(color="orange1"),
        "magenta": Style(color="magenta"),
        "bright_cyan": Style(color="bright_cyan"),
        "bright_green": Style(color="bright_green"),
    }

    # ── Hoisted prefix column values (shared by both helpers) ──
    empty_time = S["dim"].render(_pad("", 8))
    empty_model = S["dim"].render(_pad("", 18))
    empty_tag = S["dim"].render(_pad("", tag_width))
    COL_PREFIX = f"{empty_time}  {empty_model}  {empty_tag} "
    prefix_width = 8 + 2 + 18 + 2 + tag_width + 1

    # ── Border emission helpers ──
    def _bottom_line(depth: int, color: str = "cyan") -> str:
        indent_str = "│" + "  " * depth
        bw_raw = (
            console.width - prefix_width - len(indent_str)
            if console.width
            else 0
        )
        bw = max(20, bw_raw) if bw_raw else 60
        border_line = f"╰─{'─' * (bw - 2)}"
        return (
            f"{COL_PREFIX}"
            f"{S['dim'].render(indent_str)}"
            f"{S[color].render(border_line)}"
        )

    def _top_line(
        depth: int, session_agent_str: str = "", color: str = "cyan"
    ) -> str:
        indent_str = "│" + "  " * depth
        label = (
            f" [session:{session_agent_str}] "
            if session_agent_str
            else " [session] "
        )
        bw_raw = (
            console.width - prefix_width - len(indent_str)
            if console.width
            else 0
        )
        bw = max(20, bw_raw) if bw_raw else 60
        max_label = max(4, bw - 2 - 1)
        label = _truncate_display(label, max_label)
        label_len = cell_len(label)
        fill = max(1, bw - 2 - label_len)
        border_top = f"╭─{label}{'─' * fill}"
        return (
            f"{COL_PREFIX}"
            f"{S['dim'].render(indent_str)}"
            f"{S[color].render(border_top)}"
        )

    # ── Build all output lines ──
    lines: list[str] = []
    depth_color: dict[int, str] = {}
    for pos, op in enumerate(ops):
        e = op["event"]
        ts = e.get("timestamp", "")
        time_str = ts[11:19] if len(ts) >= 19 else ts[-8:]
        time_str = time_str.ljust(8)  # fixed 8-char width
        i = op["index"]
        etype = e.get("type", "")
        depth = e.get("depth", 0)

        # Fixed-width time column: always 8 chars, no indent
        time_padded = _pad(time_str, 8)

        # Indent for sub-agent depth (content column only)
        indent = "  " * depth if depth > 0 else ""
        # sep_seg grows from 1 char (depth 0: "│") to 2+2d (depth d: "│  │..."),
        # subtract the extra chars so content fits terminal width
        depth_content_offset = 0 if depth == 0 else (1 + 2 * depth)

        # ── Borders (pre-computed) ──
        for dep in bottoms.get(pos, []):
            lines.append(
                _bottom_line(dep, depth_color.get(dep, _DEFAULT_AGENT_COLOR))
            )
            depth_color.pop(dep, None)
        for dep, bsid in tops.get(pos, []):
            session_agent_str = agent_map.get(bsid, "")
            color = AGENT_COLORS.get(session_agent_str, _DEFAULT_AGENT_COLOR)
            depth_color[dep] = color
            lines.append(_top_line(dep, session_agent_str, color))

        # Model column: padded to 18, truncated if too long
        model_raw = model_map[i] if i < len(model_map) else ""
        if len(model_raw) > 18:
            model_raw = model_raw[:18]
        model_plain = model_raw or "—"
        model_padded = _pad(model_plain, 18)
        model_style_obj = S["blue"] if model_raw else S["dim"]

        # Build styled segments
        time_seg = S["dim"].render(time_padded)
        model_seg = model_style_obj.render(model_padded)
        sep_seg = (
            S["dim"].render("│" + indent)
            + S[depth_color.get(depth, _DEFAULT_AGENT_COLOR)].render("│")
            if depth > 0
            else S["dim"].render(f"{indent}│")
        )

        if etype in ("llm", "llm_stream"):
            # ── LLM call / stream ──
            detail = e.get("detail", {})
            agent_name = detail.get("agent", "")
            agent_suffix = (
                f"({agent_name}) " if agent_name and agent_name != "?" else ""
            )
            dur = e.get("duration_sec")
            dur_seg = f"{S['dim'].render(f'[{dur:.1f}s]')} " if dur else ""
            label = "🤖 LLM stream" if etype == "llm_stream" else "🤖 LLM call"
            tag_padded = _pad(label, tag_width)
            tag_seg = S["blue"].render(tag_padded)
            lines.append(
                f"{time_seg}  {model_seg}  {tag_seg} {sep_seg} {dur_seg}{agent_suffix}"
            )

        elif e.get("source") == "zoo":
            # ── ZooKeeper intervention ──
            summary = e.get("summary", "")
            tag_padded = _pad("zoo", tag_width)
            tag_seg = S["cyan"].render(tag_padded)
            summary = _truncate_display(
                summary,
                max(20, content_width - depth_content_offset),
            )
            lines.append(
                f"{time_seg}  {model_seg}  {tag_seg} {sep_seg} "
                f"{S['dim'].render(summary)}"
            )

        elif e.get("source") == "db":
            # ── Database message (user / assistant) ──
            if etype == "user_msg":
                tag_padded = _pad("User", tag_width)
                tag_seg = S["green"].render(tag_padded)
                content = e.get("content", "")
                if not verbose:
                    one_line = " ".join(content.split())
                    content = _truncate_display(
                        one_line, content_width - depth_content_offset
                    )
                lines.append(
                    f"{time_seg}  {model_seg}  {tag_seg} {sep_seg} {content}"
                )

            elif etype == "assistant_reply":
                agent = e.get("agent", "") or "assistant"
                tag_padded = _pad(f"{agent}:", tag_width)
                tag_seg = S["blue"].render(tag_padded)
                content = e.get("content", "")
                mc = e.get("msg_time_completed")
                mcr = e.get("msg_time_created")
                dur = e.get("duration_sec") or (
                    (mc - mcr) / 1000.0
                    if mc is not None and mcr is not None and mc > mcr
                    else None
                )
                # Account for "[X.Xs] " prefix width when truncating
                dur_visible_chars = len(f"[{dur:.1f}s] ") if dur else 0
                if not verbose:
                    one_line = " ".join(content.split())
                    avail = max(
                        20,
                        content_width
                        - dur_visible_chars
                        - depth_content_offset,
                    )
                    content = _truncate_display(one_line, avail)
                dur_prefix = (
                    f"{S['dim'].render(f'[{dur:.1f}s]')} " if dur else ""
                )
                lines.append(
                    f"{time_seg}  {model_seg}  {tag_seg} {sep_seg} {dur_prefix}{content}"
                )

            elif etype == "assistant_reasoning" and verbose:
                tag_padded = _pad("🧠 Reasoning", tag_width)
                tag_seg = S["dim"].render(tag_padded)
                content = e.get("content", "")
                lines.append(
                    f"{time_seg}  {model_seg}  {tag_seg} {sep_seg} {content}"
                )

            # unmatched db event type — skip silently

        else:
            # ── Tool call ──
            summary = e.get("summary", "")
            if ": " in summary:
                tool_name, arg = summary.split(": ", 1)
            else:
                tool_name = summary
                arg = ""

            icon = e.get("icon", "●")
            color = TYPE_STYLES.get(etype, "white")
            op_label = OP_LABELS.get(etype, "其他")
            tag_plain = f"{icon} {op_label}"
            tag_padded = _pad(tag_plain, tag_width)
            tag_seg = S.get(color, S["white"]).render(tag_padded)

            dur = e.get("duration_sec")
            dur_seg = f"{S['dim'].render(f'[{dur:.1f}s]')} " if dur else ""

            line_content = f"{tool_name} {arg}".strip()
            line_content = " ".join(line_content.split())  # collapse newlines
            # Account for "[X.Xs] " prefix width when truncating
            dur_visible_chars = len(f"[{dur:.1f}s] ") if dur else 0
            line_content = _truncate_display(
                line_content,
                max(
                    20,
                    content_width - dur_visible_chars - depth_content_offset,
                ),
            )
            lines.append(
                f"{time_seg}  {model_seg}  {tag_seg} {sep_seg} {dur_seg}{line_content}"
            )

    # ── Close any open child blocks (from after-loop bottoms) ──
    for dep in bottoms.get(len(ops), []):
        lines.append(
            _bottom_line(dep, depth_color.get(dep, _DEFAULT_AGENT_COLOR))
        )
        depth_color.pop(dep, None)

    # Output all lines at once
    console.file.write("\n".join(lines))
    console.file.write("\n")

    # Render bottom stats line
    tools = stats.get("tools", {})
    tool_parts = []
    if tools.get("read"):
        tool_parts.append(f"读{tools['read']}")
    if tools.get("write"):
        tool_parts.append(f"写{tools['write']}")
    if tools.get("exec"):
        tool_parts.append(f"执行{tools['exec']}")
    if tools.get("orch"):
        tool_parts.append(f"编排{tools['orch']}")
    if tools.get("other"):
        tool_parts.append(f"其他{tools['other']}")
    tool_str = (
        f"tools: {tools['total']}({'/'.join(tool_parts)})"
        if tool_parts
        else f"tools: {tools['total']}"
    )

    zoo_total = stats.get("zoo_interventions", 0)
    total_llm_dur = sum(
        e.get("duration_sec", 0)
        for e in timeline
        if e.get("type") in ("llm", "llm_stream") and e.get("duration_sec")
    )
    llm_dur_str = f" ({total_llm_dur:.1f}s)" if total_llm_dur > 0 else ""

    console.print()
    console.print(
        f"[bold]总计:[/bold] {stats['total_events']} events | "
        f"{stats['llm_calls']} LLM{llm_dur_str} | "
        f"{tool_str} | "
        f"{zoo_total} zoo"
    )


def _find_session_info(timeline: list[dict]) -> dict | None:
    """Extract session info (slug, agent, model, etc.) from timeline events."""
    for e in timeline:
        if e.get("type") == "session" and e.get("detail", {}).get("slug"):
            d = e["detail"]
            return {
                "slug": d.get("slug", ""),
                "agent": d.get("agent", ""),
                "model": d.get("model_id", d.get("model", "")),
                "provider": d.get("model_provider", d.get("provider", "")),
                "project_id": d.get("project_id", ""),
                "title": d.get("title", ""),
            }
    return None


def _render_session_panel(
    session_id: str,
    timeline: list[dict],
    stats: dict,
    console: Console,
    compact: bool = False,
) -> None:
    """Render session summary panel.

    Args:
        session_id: The session ID to display.
        timeline: Unified event list (used to extract session info).
        stats: Stats dict from :func:`build_stats`.
        console: Rich console to print to.
        compact: If ``True``, render a single-line compact header instead
            of the full detail panel (used for default ``show`` output).
    """
    info = _find_session_info(timeline)

    if compact:
        # ── Compact single-line header ──
        slug = info.get("slug", "") if info else ""
        agent = info.get("agent", "") if info else ""
        model = info.get("model", "") if info else ""

        ts = stats.get("time_span")
        dur_str = ""
        if ts:
            dur = ts.get("seconds", 0)
            mins, secs = divmod(dur, 60)
            dur_str = f"{mins}m {secs}s" if mins else f"{secs}s"

        sid_short = (
            f"{session_id[:20]}…"  # session ID 为纯 ASCII，无需 cell_len 截断
        )
        title_str = (
            f"Session: {slug} ({sid_short})"
            if slug
            else f"Session ({sid_short})"
        )

        parts = []
        if agent:
            parts.append(f"Agent: [green]{agent}[/green]")
        if model:
            parts.append(f"Model: [blue]{model}[/blue]")
        if dur_str:
            parts.append(f"Duration: [yellow]{dur_str}[/yellow]")

        child_line = ""
        if stats.get("child_sessions"):
            child_line = (
                f"子 sessions: [cyan]{stats['total_child_sessions']}[/cyan]"
            )

        content = "  ".join(parts)
        if child_line:
            if content:
                content += f"\n{child_line}"
            else:
                content = child_line

        panel = Panel(
            content,
            title=f"[bold]{title_str}[/bold]",
            border_style="cyan",
        )
        console.print(panel)
        console.print()
        return

    # ── Full detail panel (verbose mode or fallback) ──
    lines = [f"Session ID: [cyan]{session_id}[/cyan]"]

    if info:
        if info.get("slug"):
            lines.append(f"Slug:       [bold]{info['slug']}[/bold]")
        if info.get("agent"):
            lines.append(f"Agent:      [green]{info['agent']}[/green]")
        if info.get("model"):
            lines.append(f"Model:      [blue]{info['model']}[/blue]")
        if info.get("provider"):
            lines.append(f"Provider:   {info['provider']}")
        if info.get("project_id"):
            lines.append(f"Project ID: [dim]{info['project_id']}[/dim]")

    ts = stats.get("time_span")
    if ts:
        dur = ts.get("seconds", 0)
        mins, secs = divmod(dur, 60)
        dur_str = f"{mins}m {secs}s" if mins else f"{secs}s"
        lines.append(f"Duration:   [yellow]{dur_str}[/yellow]")

    # Child session summary
    child_sessions = stats.get("child_sessions")
    if child_sessions:
        lines.append(
            f"子 sessions: [cyan]{stats['total_child_sessions']}[/cyan]"
        )
        for cs in child_sessions:
            agent = cs.get("agent", "?")
            sid_short = cs["session_id"][:12] + "..."
            lines.append(
                f"  ├ [dim]{sid_short}[/dim] "
                f"[green]{agent}[/green] "
                f"[yellow]{cs['event_count']}[/yellow] events"
            )
        lines.append("")

    tools = stats.get("tools", {})
    tool_parts = []
    if tools.get("read"):
        tool_parts.append(f"读{tools['read']}")
    if tools.get("write"):
        tool_parts.append(f"写{tools['write']}")
    if tools.get("exec"):
        tool_parts.append(f"执行{tools['exec']}")
    if tools.get("orch"):
        tool_parts.append(f"编排{tools['orch']}")
    if tools.get("other"):
        tool_parts.append(f"其他{tools['other']}")
    tool_str = (
        f"tools: {tools['total']}({'/'.join(tool_parts)})"
        if tool_parts
        else f"tools: {tools['total']}"
    )

    lines.append("")

    total_llm_dur = sum(
        e.get("duration_sec", 0)
        for e in timeline
        if e.get("type") in ("llm", "llm_stream") and e.get("duration_sec")
    )
    llm_dur_str = f" ({total_llm_dur:.1f}s)" if total_llm_dur > 0 else ""

    lines.append(
        f"[bold]Stats:[/bold] {stats['total_events']} events | "
        f"{stats['llm_calls']} LLM{llm_dur_str} | "
        f"{tool_str} | "
        f"{stats['permission_checks']} permissions | "
        f"{stats['zoo_interventions']} zoo"
    )

    panel = Panel(
        "\n".join(lines),
        title="[bold]Session Summary[/bold]",
        border_style="cyan",
    )
    console.print(panel)
    console.print()


def _collect_child_sessions_info(
    timeline: list[dict],
    root_session_id: str,
) -> list[dict]:
    """Collect per-child-session stats for the summary panel.

    Args:
        timeline: List of unified event dicts (may include children).
        root_session_id: The root session ID (excluded from children).

    Returns:
        List of dicts with ``session_id``, ``depth``, ``agent``,
        ``event_count`` for each non-root session in the timeline.
    """
    seen: dict[str, dict] = {}
    for e in timeline:
        sid = e.get("session_id", "")
        if sid == root_session_id or not sid:
            continue
        if sid not in seen:
            seen[sid] = {
                "session_id": sid,
                "depth": e.get("depth", 0),
                "agent": e.get("session_agent", "?"),
                "event_count": 0,
            }
        seen[sid]["event_count"] += 1

    # Sort by depth then session_id for stable output
    return sorted(seen.values(), key=lambda x: (x["depth"], x["session_id"]))


