def cmd_steps(args: argparse.Namespace) -> None:
    """Step-by-step token timeline.

    Queries step-finish records from the SQLite database, computes
    per-step metrics (delta cache, cache hit rate, duration), and
    optionally overlays zoo hook events and child session data.
    """
    console = Console(no_color=getattr(args, "no_color", False))
    db_path = getattr(args, "db", "~/.local/share/opencode/opencode.db")
    use_json = getattr(args, "json", False)

    steps = query_step_data(args.session_id, db_path)
    if not steps:
        if use_json:
            print(json.dumps({"steps": [], "summary": {}}, ensure_ascii=False))
        else:
            console.print(
                "[yellow]No step data found for this session.[/yellow]"
            )
        return

    # Add metadata
    for s in steps:
        s["_session_id"] = args.session_id

    # Discover child steps if requested
    child_data = []
    if getattr(args, "child", False):
        child_data = _discover_child_steps(args.session_id, db_path)

    all_steps: list[dict] = list(steps)
    for _sid, _depth, child_steps_list in child_data:
        all_steps.extend(child_steps_list)

    # Sort by time_created and assign display indices
    all_steps.sort(key=lambda s: s.get("time_created", ""))
    for i, s in enumerate(all_steps, 1):
        s["_display_index"] = i

    # Parse zoo log for hook overlays (if enabled)
    hook_overlays: dict[int, list[str]] = {}
    if getattr(args, "hook_overlays", True):
        # Collect all session IDs needing hook lookup
        hook_sids = {args.session_id}
        for sid, _depth, _ in child_data:
            hook_sids.add(sid)

        for sid in hook_sids:
            try:
                zoo_path = resolve_session_path(sid)
                if zoo_path and os.path.isfile(zoo_path):
                    zoo_events = parse_zoo_log(zoo_path)
                    matched = _match_hooks_to_steps(all_steps, zoo_events)
                    for k, v in matched.items():
                        hook_overlays.setdefault(k, []).extend(v)
            except FileNotFoundError:
                pass

    # Compute per-step metrics
    prev_cache = 0
    for s in all_steps:
        if s["step_index"] == 1:
            delta_cache = s["cache_write"]
        else:
            delta_cache = s["cache_read"] - prev_cache
        s["delta_cache"] = delta_cache
        total_input = s["input_tokens"] + s["cache_read"]
        s["cache_pct"] = (
            (s["cache_read"] / total_input * 100) if total_input > 0 else 0.0
        )
        s["duration"] = (
            _parse_iso(s["time_updated"]) - _parse_iso(s["time_created"])
        ).total_seconds()
        # Override with message-level timing if available (epoch ms).
        msg_created = s.get("msg_time_created")
        msg_completed = s.get("msg_time_completed")
        if msg_created and msg_completed:
            s["duration"] = (msg_completed - msg_created) / 1000.0
        prev_cache = s["cache_read"]

    # Apply --min-cache-drop filter
    min_drop = getattr(args, "min_cache_drop", None)
    if min_drop is not None:
        # Save old → new display_index mapping before reassignment
        old_to_new: dict[int, int] = {}
        new_steps: list[dict] = []
        for s in all_steps:
            old_di = s["_display_index"]
            if s["delta_cache"] < -min_drop:
                new_di = len(new_steps) + 1
                old_to_new[old_di] = new_di
                s["_display_index"] = new_di
                new_steps.append(s)
        all_steps = new_steps
        # Rebuild hook_overlays with new indices
        if hook_overlays:
            new_overlays: dict[int, list[str]] = {}
            for old_di, hooks in hook_overlays.items():
                new_di = old_to_new.get(old_di)
                if new_di is not None:
                    new_overlays[new_di] = hooks
            hook_overlays = new_overlays

    if use_json:
        _output_steps_json(all_steps, hook_overlays)
    else:
        _render_steps_table(all_steps, hook_overlays, console)


def _output_steps_json(
    steps: list[dict],
    hook_overlays: dict[int, list[str]],
) -> None:
    """Output steps data as JSON."""
    rows = []
    for s in steps:
        rows.append(
            {
                "step": s["_display_index"],
                "session_id": s.get("_session_id", ""),
                "cache_read": s["cache_read"],
                "delta_cache": s["delta_cache"],
                "input_tokens": s["input_tokens"],
                "output_tokens": s["output_tokens"],
                "reasoning_tokens": s["reasoning_tokens"],
                "cache_pct": round(s["cache_pct"], 2),
                "duration_sec": round(s["duration"], 2),
                "hooks": hook_overlays.get(s["_display_index"], []),
                "tools": s.get("tools", []),
                "reason": s.get("reason", ""),
                "time_created": s.get("time_created", ""),
                "time_updated": s.get("time_updated", ""),
            }
        )

    total_input = sum(s["input_tokens"] for s in steps)
    total_output = sum(s["output_tokens"] for s in steps)
    total_cache_read = sum(s["cache_read"] for s in steps)
    total_cache_delta = sum(s["delta_cache"] for s in steps)
    avg_hit = sum(s["cache_pct"] for s in steps) / len(steps) if steps else 0.0
    total_dur = sum(s["duration"] for s in steps)
    total_hooks = sum(len(v) for v in hook_overlays.values())
    total_tools = sum(len(s.get("tools", [])) for s in steps)

    print(
        json.dumps(
            {
                "steps": rows,
                "summary": {
                    "total_steps": len(steps),
                    "total_input": total_input,
                    "total_output": total_output,
                    "total_cache_read": total_cache_read,
                    "total_cache_delta": total_cache_delta,
                    "avg_hit_rate": round(avg_hit, 2),
                    "total_duration_sec": round(total_dur, 2),
                    "total_hooks": total_hooks,
                    "total_tools": total_tools,
                },
            },
            ensure_ascii=False,
            indent=2,
        )
    )


def _render_steps_table(
    steps: list[dict],
    hook_overlays: dict[int, list[str]],
    console: Console,
) -> None:
    """Render steps data as a rich table."""
    if not steps:
        console.print("[yellow]No steps to display after filtering.[/yellow]")
        return

    unique_sids = {
        s.get("_session_id", "") for s in steps if s.get("_session_id")
    }
    show_session = len(unique_sids) > 1

    table = Table(title="Step Token Timeline")
    table.add_column("Step", justify="right", no_wrap=True)
    if show_session:
        table.add_column("Session", no_wrap=True)
    table.add_column("Cache Read", justify="right", no_wrap=True)
    table.add_column("Δ Cache", justify="right", no_wrap=True)
    table.add_column("Input", justify="right", no_wrap=True)
    table.add_column("Output", justify="right", no_wrap=True)
    table.add_column("Cache%", justify="right", no_wrap=True)
    table.add_column("Duration", justify="right", no_wrap=True)
    table.add_column("Hook Events", no_wrap=True)
    table.add_column("Tools", no_wrap=True)
    table.add_column("Reason", no_wrap=True)

    for s in steps:
        di = s["_display_index"]
        sid_label = s.get("_session_id", "")
        if show_session and sid_label:
            sid_short = (
                sid_label[:12] + ".." if len(sid_label) > 14 else sid_label
            )
        else:
            sid_short = ""

        delta = s["delta_cache"]
        if delta > 0:
            delta_text = Text(f"+{delta:,}", style="green")
        elif delta < 0:
            delta_text = Text(f"{delta:,}", style="red")
        else:
            delta_text = Text("0", style="dim")

        pct = s["cache_pct"]
        if pct >= 80:
            pct_color = "green"
        elif pct >= 50:
            pct_color = "yellow"
        else:
            pct_color = "red"
        pct_str = f"{pct:>7.2f}%"
        bar = _cache_bar(pct)
        pct_display = Text.assemble(
            (pct_str, pct_color),
            (" ", ""),
            (bar, pct_color),
        )

        dur = s["duration"]
        if dur >= 60:
            dur_str = f"{int(dur // 60)}m{int(dur % 60)}s"
        else:
            dur_str = f"{dur:.1f}s"

        hooks = hook_overlays.get(di, [])
        hook_str = ", ".join(dict.fromkeys(hooks)) if hooks else ""
        if hook_str:
            hook_str = _truncate_display(hook_str, 20)

        tools = s.get("tools", [])
        tool_str = ", ".join(tools[:4]) if tools else ""
        if len(tools) > 4:
            tool_str += f" +{len(tools) - 4}"

        reason_str = s.get("reason", "")
        if reason_str:
            reason_str = _truncate_display(reason_str, 16)

        row_cells = [str(di)]
        if show_session:
            row_cells.append(sid_short)
        row_cells.extend(
            [
                f"{s['cache_read']:,}",
                delta_text,
                f"{s['input_tokens']:,}",
                f"{s['output_tokens']:,}",
                pct_display,
                dur_str,
                hook_str,
                tool_str,
                reason_str,
            ]
        )
        table.add_row(*row_cells)

    # Summary row
    total_input = sum(s["input_tokens"] for s in steps)
    total_output = sum(s["output_tokens"] for s in steps)
    total_cache_delta = sum(s["delta_cache"] for s in steps)
    avg_hit = sum(s["cache_pct"] for s in steps) / len(steps) if steps else 0.0
    total_dur = sum(s["duration"] for s in steps)
    total_hooks = sum(len(v) for v in hook_overlays.values())
    total_tools = sum(len(s.get("tools", [])) for s in steps)

    table.add_section()
    total_dur_str = (
        f"{int(total_dur // 60)}m{int(total_dur % 60)}s"
        if total_dur >= 60
        else f"{total_dur:.1f}s"
    )
    summary_cells = ["[bold]Total[/bold]"]
    if show_session:
        summary_cells.append("")
    summary_cells.extend(
        [
            "",
            Text(
                f"{total_cache_delta:+,}" if total_cache_delta != 0 else "0",
                style="green" if total_cache_delta > 0 else "red",
            ),
            f"{total_input:,}",
            f"{total_output:,}",
            f"{avg_hit:.2f}%",
            total_dur_str,
            str(total_hooks),
            str(total_tools),
            "",
        ]
    )
    table.add_row(*summary_cells)

    console.print(table)


def cmd_tokens(args: argparse.Namespace) -> None:
    """Message-level token distribution.

    Queries all messages + parts from the SQLite database, estimates
    token counts (text length / 4), and renders a distribution table
    with size bars.
    """
    console = Console(no_color=getattr(args, "no_color", False))
    db_path = getattr(args, "db", "~/.local/share/opencode/opencode.db")
    use_json = getattr(args, "json", False)

    messages = query_message_parts(args.session_id, db_path)
    if not messages:
        if use_json:
            print(
                json.dumps({"messages": [], "summary": {}}, ensure_ascii=False)
            )
        else:
            console.print(
                "[yellow]No messages found for this session.[/yellow]"
            )
        return

    rows: list[dict] = []
    for msg in messages:
        role = msg.get("role", "unknown")
        parts = msg.get("parts", [])
        msg_id = msg.get("id", "")

        total_tokens = _estimate_tokens(parts)
        segments = sum(1 for p in parts if p.get("type") != "step-finish")
        has_tool = any(p.get("type") == "tool" for p in parts)

        # Classify display role
        if role == "user":
            display_role = "user"
        elif role == "assistant":
            display_role = "tool_use" if has_tool else "assistant"
        elif role == "tool":
            display_role = "tool_result"
        else:
            display_role = role

        # First text content for preview
        first_text = ""
        for part in parts:
            if part.get("type") == "text":
                first_text = part.get("text", "")
                break

        preview = _truncate_display(first_text.replace("\n", " ").strip(), 40)

        rows.append(
            {
                "id": msg_id,
                "role": display_role,
                "tokens": total_tokens,
                "segments": segments,
                "preview": preview,
            }
        )

    if use_json:
        _output_tokens_json(rows)
    else:
        _render_tokens_table(rows, console)


def _output_tokens_json(rows: list[dict]) -> None:
    """Output token distribution as JSON."""
    total = sum(r["tokens"] for r in rows)
    by_role: dict[str, int] = {}
    for r in rows:
        by_role[r["role"]] = by_role.get(r["role"], 0) + r["tokens"]

    sorted_rows = sorted(rows, key=lambda r: r["tokens"], reverse=True)
    largest = sorted_rows[:3]

    empty_count = sum(1 for r in rows if r["tokens"] == 0)
    avg_tokens = total / len(rows) if rows else 0
    max_tokens = max((r["tokens"] for r in rows), default=0)

    print(
        json.dumps(
            {
                "messages": rows,
                "summary": {
                    "total_tokens": total,
                    "by_role": by_role,
                    "avg_tokens_per_msg": round(avg_tokens, 1),
                    "max_tokens": max_tokens,
                    "empty_parts_count": empty_count,
                    "largest_messages": [
                        {
                            "tokens": r["tokens"],
                            "role": r["role"],
                            "id": r["id"],
                        }
                        for r in largest
                    ],
                },
            },
            ensure_ascii=False,
            indent=2,
        )
    )


def _render_tokens_table(rows: list[dict], console: Console) -> None:
    """Render token distribution as a rich table.

    Auto-detects terminal width; uses wide mode (≥110 cols) to show
    ``Segments``, ``ID``, and ``Preview`` columns.
    """
    if not rows:
        return

    term_width = shutil.get_terminal_size().columns
    wide = term_width >= 110

    # Role color mapping
    role_colors = {
        "user": "green",
        "assistant": "blue",
        "tool_use": "magenta",
        "tool_result": "yellow",
    }

    max_tokens = max((r["tokens"] for r in rows), default=0)

    table = Table(title="Message Token Distribution")
    table.add_column("#", justify="right", no_wrap=True)
    table.add_column("Role", no_wrap=True)
    table.add_column("Tokens", justify="right", no_wrap=True)
    table.add_column("Size", no_wrap=True)
    if wide:
        table.add_column("Segments", justify="right", no_wrap=True)
        table.add_column("ID", no_wrap=True)
        table.add_column("Preview", no_wrap=False)
    else:
        table.add_column("ID", no_wrap=True)

    for idx, r in enumerate(rows, 1):
        color = role_colors.get(r["role"], "white")
        role_text = Text(r["role"], style=color)

        ratio = r["tokens"] / max_tokens if max_tokens > 0 else 0
        if ratio < 0.02:
            bar = "░" * 20
        else:
            filled = int(ratio * 20)
            bar = "█" * filled + "░" * (20 - filled)

        if wide:
            table.add_row(
                str(idx),
                role_text,
                f"{r['tokens']:,}",
                bar,
                str(r["segments"]),
                r["id"],
                r["preview"],
            )
        else:
            table.add_row(
                str(idx),
                role_text,
                f"{r['tokens']:,}",
                bar,
                r["id"],
            )

    # Bottom stats
    total = sum(r["tokens"] for r in rows)
    by_role: dict[str, int] = {}
    for r in rows:
        by_role[r["role"]] = by_role.get(r["role"], 0) + r["tokens"]

    sorted_rows = sorted(rows, key=lambda r: r["tokens"], reverse=True)
    largest = sorted_rows[:3]

    empty_count = sum(1 for r in rows if r["tokens"] == 0)
    avg_tokens = total / len(rows) if rows else 0
    max_tok = max((r["tokens"] for r in rows), default=0)

    stats_parts = [f"[bold]Total tokens:[/bold] {total:,}"]
    breakdown = " | ".join(
        f"{role}: {count:,}" for role, count in sorted(by_role.items())
    )
    if breakdown:
        stats_parts.append(breakdown)
    top3 = ", ".join(f"{r['tokens']:,} ({r['role']})" for r in largest)
    stats_parts.append(f"[bold]Largest:[/bold] {top3}")
    stats_parts.append(
        f"[bold]Avg:[/bold] {avg_tokens:.0f} [bold]Max:[/bold] {max_tok:,}"
    )
    if empty_count:
        stats_parts.append(f"[bold]Empty:[/bold] {empty_count}")

    console.print(table)
    console.print("  " + "  |  ".join(stats_parts))


def main() -> None:
    _setup_logging()

    parser = argparse.ArgumentParser(
        description="ZooKeeper trace — full orchestration trace with timeline merging."
        " Note: global flags (--json, --db, --no-color) must be placed"
        " after the subcommand, e.g. 'zoo-trace show --json'.",
    )

    # Global flags shared by all subcommands
    global_parser = argparse.ArgumentParser(add_help=False)
    global_parser.add_argument(
        "--json",
        action="store_true",
        help="Output as JSON instead of rich table",
    )
    global_parser.add_argument(
        "--db",
        default="~/.local/share/opencode/opencode.db",
        help="Path to SQLite database (default: ~/.local/share/opencode/opencode.db)",
    )
    global_parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI color output",
    )

    subparsers = parser.add_subparsers(dest="command", title="Commands")

    # --- show ---
    p_show = subparsers.add_parser(
        "show",
        parents=[global_parser],
        help="Show merged timeline for a session",
    )
    p_show.add_argument("session_id", help="Session ID")
    p_show.add_argument(
        "-s",
        "--subsessions",
        action="store_true",
        help="Include all child sessions in the timeline",
    )
    p_show.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Show full per-event timeline instead of grouped summary",
    )

    # --- export ---
    p_export = subparsers.add_parser(
        "export",
        parents=[global_parser],
        help="Export merged timeline as JSON trace (Jaeger or Chrome)",
    )
    p_export.add_argument("session_id", help="Session ID")
    p_export.add_argument(
        "-s",
        "--subsessions",
        action="store_true",
        help="Include all child sessions in the trace",
    )
    p_export.add_argument(
        "--format",
        choices=["jaeger", "chrome"],
        default="jaeger",
        help="导出格式 (default: jaeger)",
    )
    p_export.add_argument(
        "-o",
        "--output",
        default="trace.json",
        help="Output JSON file path (default: trace.json)",
    )

    # --- steps ---
    p_steps = subparsers.add_parser(
        "steps",
        parents=[global_parser],
        help="Step-by-step token timeline",
    )
    p_steps.add_argument("session_id", help="Session ID")
    p_steps.add_argument(
        "--hook-overlays",
        default=True,
        action=argparse.BooleanOptionalAction,
        help="Overlay zoo hook events on steps (default: enabled)",
    )
    p_steps.add_argument(
        "--child",
        action="store_true",
        help="Include child session steps",
    )
    p_steps.add_argument(
        "--min-cache-drop",
        type=int,
        default=None,
        metavar="N",
        help="Only show steps where Δ Cache < -N",
    )

    # --- tokens ---
    p_tokens = subparsers.add_parser(
        "tokens",
        parents=[global_parser],
        help="Message-level token distribution",
    )
    p_tokens.add_argument("session_id", help="Session ID")

    args = parser.parse_args()

    if args.command == "show":
        cmd_show(args)
    elif args.command == "export":
        cmd_export(args)
    elif args.command == "steps":
        cmd_steps(args)
    elif args.command == "tokens":
        cmd_tokens(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
