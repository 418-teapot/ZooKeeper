def cmd_list(_args: argparse.Namespace) -> None:
    """List all sessions from both log sources."""
    console = Console()

    # Sessions from ZooKeeper logs
    zoo_sessions = list_sessions()

    # Sessions from opencode log (parse to find session IDs)
    oc_path = os.path.expanduser("~/.local/share/opencode/log/opencode.log")
    oc_sessions: set[str] = set()
    if os.path.isfile(oc_path):
        entries = parse_opencode_log(oc_path)
        for e in entries:
            if e.get("message") == "created":
                sid = e.get("id", "")
                if sid:
                    oc_sessions.add(sid)

    if not zoo_sessions and not oc_sessions:
        console.print(
            "[yellow]No sessions found in either log source.[/yellow]"
        )
        return

    table = Table(title="Available Sessions")
    table.add_column("Session ID", style="cyan", no_wrap=True)
    table.add_column("Source", no_wrap=True)
    table.add_column("Slug / Title", style="bold")
    table.add_column("Agent", style="green")
    table.add_column("Events", justify="right")

    shown: set[str] = set()

    # Show ZooKeeper sessions first
    for s in zoo_sessions:
        sid = s["session_id"]
        if sid in shown:
            continue
        shown.add(sid)
        table.add_row(
            sid,
            "[cyan]zoo[/cyan]",
            "—",
            "—",
            str(s["event_count"]),
        )

    # Show opencode-only sessions
    for sid in sorted(oc_sessions):
        if sid in shown:
            continue
        shown.add(sid)
        table.add_row(
            sid,
            "[blue]opencode[/blue]",
            "—",
            "—",
            "—",
        )

    console.print(table)


def cmd_show(args: argparse.Namespace) -> None:
    """Show merged timeline for a session.

    Default output is a grouped operations summary.  Pass ``--verbose`` /
    ``-v`` to render the full per-event timeline (original behaviour).
    """
    console = Console()

    try:
        timeline = build_timeline(
            args.session_id,
            include_children=getattr(args, "subsessions", False),
        )
    except FileNotFoundError as e:
        console.print(f"[red]Error:[/red] {e}")
        sys.exit(1)

    if not timeline:
        console.print("[yellow]No events found for this session.[/yellow]")
        return

    # Build child session stats for the panel
    child_sessions_info = _collect_child_sessions_info(
        timeline, args.session_id
    )

    stats = build_stats(timeline, child_sessions=child_sessions_info)

    if args.verbose:
        _render_session_panel(
            args.session_id, timeline, stats, console, compact=False
        )
        _render_timeline_rich(timeline, console)
    else:
        _render_session_panel(
            args.session_id, timeline, stats, console, compact=True
        )

        _render_ops_summary(timeline, stats, console, verbose=args.verbose)


def cmd_export(args: argparse.Namespace) -> None:
    """Export merged timeline as JSON trace (Jaeger or Chrome format)."""
    console = Console()

    try:
        timeline = build_timeline(
            args.session_id,
            include_children=getattr(args, "subsessions", False),
        )
    except FileNotFoundError as e:
        console.print(f"[red]Error:[/red] {e}")
        sys.exit(1)

    if not timeline:
        console.print("[yellow]No events found for this session.[/yellow]")
        return

    if args.format == "chrome":
        doc = build_chrome_trace(timeline)
    else:
        doc = build_jaeger_doc(args.session_id, timeline)

    with open(args.output, "w", encoding="utf-8") as f:
        json.dump(doc, f, indent=2, ensure_ascii=False)

    if args.format == "chrome":
        console.print(
            f"[green]已导出 {len(doc)} 个 Chrome trace 事件到 {args.output}[/green]"
        )
    else:
        span_count = len(doc.get("data", [{}])[0].get("spans", []))
        console.print(
            f"[green]已导出 {span_count} 个 span 到 {args.output}[/green]"
        )


# ── Main ────────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(
        description="ZooKeeper trace — full orchestration trace with timeline merging.",
    )
    subparsers = parser.add_subparsers(dest="command", title="Commands")

    # --- list ---
    subparsers.add_parser(
        "list", help="List all sessions from both log sources"
    )

    # --- show ---
    p_show = subparsers.add_parser(
        "show", help="Show merged timeline for a session"
    )
    p_show.add_argument("session_id", help="Session ID")
    p_show.add_argument(
        "-s",
        "--subsessions",
        action="store_true",
        help="Include all child sessions in the timeline",
    )
    p_show.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Show full per-event timeline instead of grouped summary",
    )

    # --- export ---
    p_export = subparsers.add_parser(
        "export",
        help="Export merged timeline as JSON trace (Jaeger or Chrome)",
    )
    p_export.add_argument("session_id", help="Session ID")
    p_export.add_argument(
        "-s",
        "--subsessions",
        action="store_true",
        help="Include all child sessions in the trace",
    )
    p_export.add_argument(
        "--format",
        choices=["jaeger", "chrome"],
        default="jaeger",
        help="导出格式 (default: jaeger)",
    )
    p_export.add_argument(
        "-o",
        "--output",
        default="trace.json",
        help="Output JSON file path (default: trace.json)",
    )

    args = parser.parse_args()

    if args.command == "list":
        cmd_list(args)
    elif args.command == "show":
        cmd_show(args)
    elif args.command == "export":
        cmd_export(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
