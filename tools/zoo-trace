def _parse_iso(ts: str) -> datetime:
    """Parse ISO 8601 timestamp string to datetime.

    Args:
        ts: ISO 8601 string (may end with ``Z``).

    Returns:
        Parsed datetime in UTC, or ``datetime.min`` on failure.
    """
    if not ts:
        return datetime.min.replace(tzinfo=timezone.utc)
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt
    except (ValueError, AttributeError):
        return datetime.min.replace(tzinfo=timezone.utc)


def _cache_bar(pct: float, width: int = 20) -> str:
    """Render a cache hit rate bar.

    Each char = 100/width percentage points; ▏..▉ = 1..7/8 sub-steps;
    ``░`` = zero placeholder.

    Args:
        pct: Percentage value (0-100).
        width: Total character width (default 20).

    Returns:
        Bar string of exactly *width* characters.
    """
    each_pct = 100.0 / width  # e.g. 5.0 pp per char for width=20
    full = int(pct // each_pct)  # e.g. 99.98 // 5.0 = 19
    remainder = pct % each_pct  # e.g. 0.98
    frac_idx = int(remainder / each_pct * 8)  # 0-7
    frac_chars = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]
    bar = "█" * min(full, width)
    bar += frac_chars[min(frac_idx, 7)] if full < width else ""
    bar = bar.ljust(width, "░")
    return bar[:width]


def _match_hooks_to_steps(
    steps: list[dict],
    zoo_events: list[dict],
) -> dict[int, list[str]]:
    """Match zoo hook events to steps by timestamp proximity.

    A hook event belongs to step *N* if its timestamp falls between
    ``step[N-1].time_created`` and ``step[N].time_created`` (for N > 1),
    or before ``step[0].time_created`` (for N = 1).

    Args:
        steps: List of step dicts (must have ``_display_index`` and
            ``time_created``).
        zoo_events: List of parsed zoo JSONL event dicts.

    Returns:
        Dict mapping ``_display_index`` to list of hook names.
    """
    result: dict[int, list[str]] = {}

    for ev in zoo_events:
        hook = ev.get("hook", "")
        if not hook:
            continue
        ts = ev.get("timestamp", "")

        matched = False
        for i, step in enumerate(steps):
            di = step["_display_index"]
            step_start = step["time_created"]

            if i == 0:
                if ts <= step_start:
                    result.setdefault(di, []).append(hook)
                    matched = True
                    break
            else:
                prev_end = steps[i - 1]["time_created"]
                if prev_end < ts <= step_start:
                    result.setdefault(di, []).append(hook)
                    matched = True
                    break

        if not matched and steps:
            if ts > steps[-1]["time_created"]:
                result.setdefault(steps[-1]["_display_index"], []).append(hook)

    return result


def _discover_child_steps(
    session_id: str,
    db_path: str,
) -> list[tuple[str, int, list[dict]]]:
    """发现子 session 并批量查询它们的 step 数据。

    使用 ``query_step_data_batch`` 一次性查询所有子 session 的 step 数据，
    避免 N+1 次独立 DB 查询。

    Args:
        session_id: 根 session ID。
        db_path: SQLite 数据库路径。

    Returns:
        子 session 的 ``(sid, depth, steps)`` 元组列表（不含根 session）。
    """
    oc_path = os.path.expanduser("~/.local/share/opencode/log/opencode.log")
    if not os.path.isfile(oc_path):
        return []

    all_entries = _parse_opencode_all(oc_path)
    discovered = _discover_child_sessions_from_entries(all_entries, session_id)

    # 收集所有子 session ID（depth > 0）
    child_sids = [sid for sid, depth in discovered if depth > 0]
    if not child_sids:
        return []

    # 一次性批量查询，而非逐 session 循环
    all_child_steps = query_step_data_batch(child_sids, db_path)

    # 按 session_id 分组
    steps_by_sid: dict[str, list[dict]] = {}
    for step in all_child_steps:
        steps_by_sid.setdefault(step["session_id"], []).append(step)

    # 构建 depth 查找表
    depth_map = dict(discovered)

    result: list[tuple[str, int, list[dict]]] = []
    for sid in child_sids:
        child_steps = steps_by_sid.get(sid, [])
        depth = depth_map[sid]
        for s in child_steps:
            s["_session_id"] = sid
            s["_child_depth"] = depth
        if child_steps:
            result.append((sid, depth, child_steps))
    return result


