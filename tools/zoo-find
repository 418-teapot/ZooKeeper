#!/usr/bin/env python3
"""ZooKeeper session finder -- search OpenCode sessions in SQLite.

Session ID resolution: Requires a full session ID for ``--session``
(prefix resolution not supported).  Use ``zoo-log`` or ``zoo-inspect``
for prefix-based log file resolution.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

from _db import (
    _estimate_tokens,
    _setup_logging,
    query_message_by_ids,
    query_message_parts,
    query_sessions,
    query_sessions_all,
    query_sessions_exact,
)
from rich.console import Console
from rich.table import Table


def _resolve_db_path(db_path: str) -> str:
    """Expand user path and verify the DB exists.

    Args:
        db_path: Path to the SQLite database (may contain ~).

    Returns:
        Expanded absolute path to the database file.
    """
    return os.path.expanduser(db_path)


def _build_table(results: list[dict], *, is_all: bool) -> Table:
    """Build a rich Table from session results.

    Args:
        results: List of session dicts from ``_db`` queries.
        is_all: If True, include an Agent column (for ``--all`` mode).

    Returns:
        A configured ``rich.table.Table`` with rows populated.
    """
    table = Table(show_header=True, header_style="bold")
    table.add_column("Title", style="white")
    if is_all:
        table.add_column("Agent", style="cyan")
    table.add_column("Session ID", style="cyan", no_wrap=True)
    table.add_column("Updated", style="green")

    for s in results:
        title = s.get("title", "")
        session_id = s.get("id", "")
        updated = s.get("time_updated", "")
        if updated:
            updated = updated.replace("T", " ")[:19]

        row: list[str] = [title, session_id, updated]
        if is_all:
            agent = s.get("agent", "")
            row.insert(1, agent)
        table.add_row(*row)

    return table


def _print_session_table(
    results: list[dict],
    args: argparse.Namespace,
) -> None:
    """Print session results as a single ID or a rich table.

    Single match -> plain session ID (suitable for ``$(...)`` piping).
    Multiple matches -> formatted rich table.

    Args:
        results: List of session dicts from ``_db`` queries.
        args: Parsed command-line arguments.
    """
    console = Console(no_color=args.no_color)

    if len(results) == 1 and not args.json:
        # Single match: output only the session ID (pipe-friendly)
        print(results[0]["id"])
        return

    if args.json:
        _print_json(results, args)
        return

    # Multiple matches: render a rich table
    is_all = bool(args.all)

    if is_all:
        console.print(
            "\n[bold]All main sessions (most recent first):[/bold]\n"
        )
    elif args.keyword:
        console.print(
            f"\n[bold]Found {len(results)} sessions"
            f' matching "{args.keyword}":[/bold]\n'
        )
    else:
        console.print(f"\n[bold]Found {len(results)} sessions:[/bold]\n")

    table = _build_table(results, is_all=is_all)
    console.print(table)


def _print_json(results: list[dict], args: argparse.Namespace) -> None:
    """Print results wrapped in a JSON envelope.

    Args:
        results: List of session or message dicts.
        args: Parsed command-line arguments.
    """
    keyword = ""
    if args.keyword:
        keyword = args.keyword
    elif args.exact:
        keyword = args.exact

    envelope = {
        "keyword": keyword,
        "matches": len(results),
        "sessions": results,
    }
    json.dump(envelope, sys.stdout, indent=2, default=str, ensure_ascii=False)
    print()


def cmd_keyword(args: argparse.Namespace) -> None:
    """Fuzzy search sessions by keyword.

    Args:
        args: Parsed command-line arguments.
    """
    db_path = _resolve_db_path(args.db)
    results = query_sessions(args.keyword, db_path, args.session_list_limit)

    if not results:
        print(
            f'Error: no sessions found matching "{args.keyword}"',
            file=sys.stderr,
        )
        sys.exit(2)

    _print_session_table(results, args)


def cmd_all(args: argparse.Namespace) -> None:
    """List all root sessions (most recent first).

    Args:
        args: Parsed command-line arguments.
    """
    db_path = _resolve_db_path(args.db)
    results = query_sessions_all(
        db_path,
        include_children=False,
        limit=args.session_list_limit,
    )

    if not results:
        print(
            "Error: no sessions found in database.",
            file=sys.stderr,
        )
        sys.exit(2)

    _print_session_table(results, args)


def cmd_exact(args: argparse.Namespace) -> None:
    """Exact title match search.

    Args:
        args: Parsed command-line arguments.
    """
    db_path = _resolve_db_path(args.db)
    results = query_sessions_exact(args.exact, db_path)

    if not results:
        print(
            f'Error: no session found with exact title "{args.exact}"',
            file=sys.stderr,
        )
        sys.exit(2)

    _print_session_table(results, args)


def cmd_message(args: argparse.Namespace) -> None:
    """Retrieve messages by their IDs.

    Args:
        args: Parsed command-line arguments.
    """
    db_path = _resolve_db_path(args.db)
    results = query_message_by_ids(
        args.message,
        args.session,
        db_path,
        args.scan,
    )

    if not results:
        print(
            f"Error: no messages found matching IDs: {' '.join(args.message)}",
            file=sys.stderr,
        )
        sys.exit(2)

    if args.json:
        keyword = " ".join(args.message)
        envelope = {
            "keyword": keyword,
            "matches": len(results),
            "messages": results,
        }
        json.dump(
            envelope, sys.stdout, indent=2, default=str, ensure_ascii=False
        )
        print()
    else:
        # 纯文本输出：每行一条消息的简要信息
        console = Console(no_color=args.no_color)
        for msg in results:
            role = msg.get("role", "unknown")
            parts = msg.get("parts", [])
            msg_id = msg.get("id", "")
            tokens = _estimate_tokens(parts)
            preview = _preview_text(parts)
            console.print(
                f"Message {msg_id} ({role}, {tokens:,} tokens): {preview}"
            )


def _classify_role(role: str, parts: list[dict]) -> str:
    """Classify a message's display role.

    Uses the shared ``_estimate_tokens`` logic from ``_db``:
    - ``user`` stays ``user``
    - ``assistant`` with tool parts → ``tool_use``
    - ``tool`` → ``tool_result``
    - otherwise raw role.

    Args:
        role: The raw role from message.data.
        parts: List of parsed part.data dicts.

    Returns:
        Display role string.
    """
    has_tool = any(p.get("type") == "tool" for p in parts)
    if role == "user":
        return "user"
    if role == "assistant":
        return "tool_use" if has_tool else "assistant"
    if role == "tool":
        return "tool_result"
    return role


def _preview_text(parts: list[dict]) -> str:
    """Build a short preview from the first text part.

    For tool parts, show tool name + key state info instead.

    Args:
        parts: List of parsed part.data dicts.

    Returns:
        Truncated preview string (max ~40 chars).
    """
    for part in parts:
        ptype = part.get("type", "")
        if ptype == "text":
            text = part.get("text", "")
            text = text.replace("\n", " ").strip()
            if len(text) > 40:
                text = (
                    text[:37] + "..."
                )  # 预览文本在 40 字符边界极少出现 CJK，直接切片即可
            return text
        if ptype == "tool":
            tool_name = part.get("tool", "?")
            state = part.get("state", {})
            inp = state.get("input", {})
            if isinstance(inp, dict):
                # Show first key-value pair
                key_info = "; ".join(
                    f"{k}={v}" for k, v in list(inp.items())[:2]
                )
            else:
                key_info = str(inp)[
                    :20
                ]  # tool 入参 key 为 ASCII，直接切片即可
            preview = f"{tool_name}: {key_info}"
            if len(preview) > 40:
                preview = preview[:37] + "..."
            return preview
    return ""


def cmd_session_messages(args: argparse.Namespace) -> None:
    """List all messages in a session as a brief table.

    Args:
        args: Parsed command-line arguments.
    """
    db_path = _resolve_db_path(args.db)
    messages = query_message_parts(args.session, db_path)

    if not messages:
        console = Console(no_color=args.no_color)
        console.print(
            f"[red]Error:[/red] no messages found for session: {args.session}"
        )
        sys.exit(2)

    rows: list[dict] = []
    for msg in messages:
        role = msg.get("role", "unknown")
        parts = msg.get("parts", [])
        msg_id = msg.get("id", "")

        total_tokens = _estimate_tokens(parts)
        display_role = _classify_role(role, parts)
        preview = _preview_text(parts)

        rows.append(
            {
                "id": msg_id,
                "role": display_role,
                "tokens": total_tokens,
                "preview": preview,
            }
        )

    if args.json:
        # JSON 输出：使用 envelope 结构 {"keyword": "", "matches": N, "messages": [...]}
        output = [
            {
                "index": idx + 1,
                "role": r["role"],
                "tokens": r["tokens"],
                "id": r["id"],
                "preview": r["preview"],
            }
            for idx, r in enumerate(rows)
        ]
        envelope = {
            "keyword": args.session,
            "matches": len(output),
            "messages": output,
        }
        json.dump(envelope, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return

    console = Console(no_color=args.no_color)

    role_colors = {
        "user": "green",
        "assistant": "blue",
        "tool_use": "magenta",
        "tool_result": "yellow",
    }

    console.print(
        f"\n[bold]Messages for session:[/bold] {args.session}"
        f" ([green]{len(rows)} messages[/green])\n"
    )

    table = Table(show_header=True, header_style="bold")
    table.add_column("#", justify="right", no_wrap=True)
    table.add_column("Role", no_wrap=True)
    table.add_column("Tokens", justify="right", no_wrap=True)
    table.add_column("ID", no_wrap=True)
    table.add_column("Preview", no_wrap=False)

    for idx, r in enumerate(rows, 1):
        color = role_colors.get(r["role"], "white")
        role_text = r["role"]
        table.add_row(
            str(idx),
            f"[{color}]{role_text}[/{color}]",
            f"{r['tokens']:,}",
            r["id"],
            r["preview"],
        )

    console.print(table)
    console.print()


def build_parser() -> argparse.ArgumentParser:
    """Build the argument parser for zoo-find.

    Returns:
        Configured ``ArgumentParser`` instance.
    """
    parser = argparse.ArgumentParser(
        description=(
            "ZooKeeper session finder -- search OpenCode sessions"
            " and messages in SQLite."
        ),
    )

    # Positional keyword for fuzzy search
    parser.add_argument(
        "keyword",
        nargs="?",
        default=None,
        help="Fuzzy keyword to search session titles",
    )

    # Mode flags
    parser.add_argument(
        "--all",
        action="store_true",
        help="List all main (root) sessions, most recent first",
    )
    parser.add_argument(
        "--exact",
        metavar="TITLE",
        help="Search sessions with exact title match",
    )
    parser.add_argument(
        "--message",
        nargs="+",
        metavar="ID",
        help="Retrieve one or more messages by ID",
    )

    # Message-specific options
    parser.add_argument(
        "--session",
        metavar="SID",
        help="Session ID: list all messages when used alone,"
        " or scope for --message search",
    )
    parser.add_argument(
        "--scan",
        type=int,
        default=200,
        metavar="N",
        help="Number of recent sessions to scan when --session"
        " not given (default: 200)",
    )

    # Global options
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output results as a JSON envelope",
    )
    parser.add_argument(
        "--db",
        default="~/.local/share/opencode/opencode.db",
        help="Path to the OpenCode SQLite database"
        " (default: ~/.local/share/opencode/opencode.db)",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable colored output",
    )
    parser.add_argument(
        "--session-list-limit",
        type=int,
        default=5000,
        metavar="N",
        help="Maximum number of sessions to return (default: 5000)",
    )

    return parser


def main() -> None:
    """Entry point for zoo-find."""
    _setup_logging()
    parser = build_parser()
    args = parser.parse_args()

    # Warn if both keyword and --session are provided (keyword will be ignored)
    if args.keyword is not None and args.session is not None:
        print(
            f"Warning: keyword argument '{args.keyword}' is ignored when"
            " --session is specified",
            file=sys.stderr,
        )

    # Dispatch to the appropriate command handler
    if args.message:
        cmd_message(args)
    elif args.session is not None:
        cmd_session_messages(args)
    elif args.exact is not None:
        cmd_exact(args)
    elif args.all:
        cmd_all(args)
    elif args.keyword is not None:
        cmd_keyword(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
